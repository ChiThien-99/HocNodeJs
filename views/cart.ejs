<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/img/logo_imzen01-final - 32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/img/logo_imzen01-final - 16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/img/logo_imzen01-final.png" sizes="180x180">
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Geomini-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
</head>
<body>
  <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm">
            <i class="fa-solid fa-check"></i> Xác nhận
          </button>
          <button id="btnDeny">
            <i class="fa-solid fa-xmark"></i> Từ chối
          </button>
        </div>
      </div>
    <header>
      <div>
       <h1>
        <a href="/" class="logo-link">
          <img src="/img/logo_imzen01-final.webp" alt="logo">
          <span>VÂN HY</span>
        </a>
        </h1>
      </div>
      <div>
        <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
       </button>
       <span id="countCartHamburgerBtn">0</span>
      </div>
      <div id="divNavMenu">
        <div id="navMenu">
        <nav>
          <ul>
            <li><a href="/">Trang chủ</a></li>
            <li>
              <a href="/app?sort=createAt" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="/device">Thiết bị</a></li>
            <li><a href="/blogs">Blog</a></li>
            <li><a href="#">Hợp tác</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button type="button" id="btnRegisterClient">Đăng ký</button>
          <button type="button" id="btnLoginClient">Đăng nhập</button>
        </div>
        <div id="containerUserLogin">
          <div id="infoUserLogin">
          <h3>Tên user</h3>
          <div id="groupBtnUserLogin">
            <button id="btnDashboardUserLogin">Dashboard</button>
            <button id="btnLogoutUserLogin">Đăng xuất</button>
          </div>
        </div>
        <div id="bagShopping">
          <i class="fa-brands fa-opencart"></i>
          <span>0</span>
        </div>
        </div>
      </div>
      </div>
    </header>
    <main id="mainCart">
        <%if(!cart||cart.products.length===0){%>
            <h3>Bạn đang không có đơn hàng</h3>
        <%}else{%>
        <div id="divFormCart">
            <h3>Thông tin đơn hàng</h3>
            <div id="divOrder">
                <table id="tableOrder">
                    <thead>
                        <tr>
                        <th>STT</th>
                        <th>Tên hàng</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>Xóa</th>
                    </tr>
                    </thead>
                    <tbody>
                       <%cart.products.forEach((product,i)=>{%>
                    <tr data-idProduct="<%=product.productId%>">
                        <td><%=i+1%></td>
                        <td>
                          <div>
                            <img src="<%=product.img%>" alt="img">
                            <%=product.color==="-"?product.productName:product.productName+" "+product.color%>
                          </div>
                        </td>
                        <td><input type="number" name="quantityProduct" class="quantityProduct" value="<%=product.quantity%>" data-idProduct="<%=product.productId%>"></td>
                        <input type="hidden" name="priceProduct" class="priceProduct" value="<%=product.price%>">
                        <td><%=product.price.toLocaleString('vi-VN')%>đ</td>
                        <td><%=(product.quantity*product.price).toLocaleString('vi-VN')%>đ</td>
                        <td>
                            <button type="button" class="btnDeleteProduct" data-idProduct="<%=product.productId%>">Xóa</button>
                        </td>
                    </tr>
                    <%})%>
                    </tbody>
                </table>
            </div>
            <h3>Voucher</h3>
            <div id="listVoucher">
              <%if(!vouchers||vouchers.length===0){%>
                <b>Bạn đang không có voucher</b>
              <%}else{%>
                <%vouchers.forEach((voucher)=>{%>
              <div class="voucher-wrapper">
                <div class="voucher-sawtooth-zigzag">
                <div class="voucher">
                <div>
                  <img src="<%=voucher.image%>" alt="imgVoucher">
                </div>
                <div>
                  <h3><%=voucher.title%></h3>
                  <%-voucher.content.replace(/&nbsp;|&#160;/gi," ")%>
                  <div class="divApplyVoucher">
                    <span>Áp dụng</span>
                    <input type="checkbox" name="applyVoucher" class="applyVoucher" data-codeVoucher="<%=voucher.code%>">
                  </div>
                </div>
              </div>
                </div>
              </div>
              <%})%>
              <%}%>
            </div>
            <h3>Phương thức thanh toán</h3>
            <div id="divPaymentMethod">
              <%for(let i=0;i<cart.products.length;i++){%>
              <%if(cart.products[i].category==="device"){%>
              <label for="cod">
              <input type="radio" name="paymentMethod" value="cod" id="cod" data-paymentMethod="Thanh toán khi nhận hàng">
              <p><img src="/img/cod.webp" alt="cod"><span>Thanh toán khi nhận hàng</span></p>
              </label>
              <%break;%>
              <%}%>
              <%}%>
            <label for="bank">
              <input type="radio" name="paymentMethod" value="bank" id="bank" data-paymentMethod="Chuyển khoản ngân hàng/thẻ tín dụng">
              <p><img src="/img/bank.webp" alt="bank"><span>Chuyển khoản ngân hàng/thẻ tín dụng</span></p>
            </label>
            <label for="momo">
              <input type="radio" name="paymentMethod" value="momo" id="momo" data-paymentMethod="Ví điện tử MoMo">
              <p><img src="/img/logo_momo.webp" alt="momo"><span>Ví điện tử MoMo</span></p>
            </label>
            <label for="zalopay">
              <input type="radio" name="paymentMethod" value="zalopay" id="zalopay" data-paymentMethod="Ví điện tử ZaloPay">
              <p><img src="/img/zalopay.webp" alt="zalopay" id="logoZalopay"><span>Ví điện tử ZaloPay</span></p>
            </label>
            <label for="vnpay">
              <input type="radio" name="paymentMethod" value="vnpay" id="vnpay" data-paymentMethod="Ví điện tử VNPay">
              <p><img src="/img/logo_vnpay.webp" alt="vnpay"><span>Ví điện tử VNPay</span></p>
            </label>
            </div>
            <div id="headerReceivingInfor">
               <h3>Thông tin nhận hàng</h3>
               <button id="addReceivingInfor"><i class="fa-solid fa-plus"></i> Thêm thông tin</button>
            </div>
            <div id="formReceivingInfor">
              <label for="fullname">Họ và tên</label><br>
              <input type="text" name="fullname" id="fullname" required><br>
              <label for="tel">Số điện thoại</label><br>
              <input type="tel" name="tel" id="tel" required><br>
              <label for="provinceCity">Tỉnh/Thành phố</label><br>
              <select name="provinceCity" id="provinceCity" required>
                  <option value="">--Chọn Tỉnh/Thành phố--</option>
                  <%province.forEach(p=>{%>
                    <option value="<%=p%>"><%=p%></option>
                  <%})%>
              </select><br>
              <label for="wardsCommunes">Phường/Xã</label><br>
              <select name="wardsCommunes" id="wardsCommunes" required>
                  <option value="">--Chọn Phường/Xã--</option>
              </select><br>
              <label for="numberHouse">Tên đường, tòa nhà, số nhà</label><br>
              <input type="text" name="numberHouse" id="numberHouse" required><br>
              <label for="categoryAddress">Loại địa chỉ</label><br>
              <select name="categoryAddress" id="categoryAddress">
                <option value="office">Văn phòng</option>
                <option value="home">Nhà riêng</option>
              </select><br>
              <button type="button" id="submitFormReceivingInfor">Thêm</button>
            </div>
            <div id="contentReceivingInfor">
              <%if(!deliveryAddress||deliveryAddress.length===0){%>
              <p>Chưa có thông tin nhận hàng</p>
              <%}else{%>
                <%deliveryAddress.forEach((da)=>{%>
                <div data-idAddress="<%=da._id%>">
                  <p><span>Tên người nhận:</span> <%=da.fullname%></p>
                  <p><span>Số điện thoại:</span> <%=da.tel%></p>
                  <p><span>Địa chỉ:</span> <%=da.address%> (<%=da.category==="home"?"Nhà riêng":"Văn phòng"%>)</p>
                  <button type="button" class="btnDeleteAddress" data-idAddress="<%=da._id%>"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <%})%>
              <%}%>
            </div>
            <input type="checkbox" name="cbInvoice" id="cbInvoice">
            <label for="cbInvoice">Xuất hóa đơn công ty</label>
            <div id="divInvoice">
               <div id="headerIssueInvoice">
               <h3>Thông tin xuất hóa đơn</h3>
               <button id="addIssueInvoice"><i class="fa-solid fa-plus"></i> Thêm thông tin</button>
            </div>
            <div id="formIssueInvoice">
              <label for="nameCompany">Tên công ty</label><br>
              <input type="text" name="nameCompany" id="nameCompany" required><br>
              <label for="mstCompany">Mã số thuế</label><br>
              <input type="text" name="mstCompany" id="mstCompany" required><br>
              <p>Địa chỉ công ty</p>
              <label for="provinceCityInvoice">Tỉnh/Thành phố</label><br>
              <select name="provinceCityInvoice" id="provinceCityInvoice" required>
                  <option value="">--Chọn Tỉnh/Thành phố--</option>
                  <%province.forEach(p=>{%>
                    <option value="<%=p%>"><%=p%></option>
                  <%})%>
              </select><br>
              <label for="wardsCommunesInvoice">Phường/Xã</label><br>
              <select name="wardsCommunesInvoice" id="wardsCommunesInvoice" required>
                  <option value="">--Chọn Phường/Xã--</option>
              </select><br>
              <label for="numberCompany">Tên đường, tòa nhà, số nhà</label><br>
              <input type="text" name="numberCompany" id="numberCompany" required><br>
              <label for="mailInvoice">Mail nhận hóa đơn ( Nếu nhiều mail vui lòng phân cách bằng dấu ; )</label><br>
              <b>VD: mail01@gmail.com;mail02@gmail.com</b><br>
              <!-- <input type="email" name="mailInvoice" id="mailInvoice" required><br> -->
              <textarea name="mailInvoice" id="mailInvoice" required></textarea><br>
              <button type="button" id="submitIssueInvoice">Thêm</button>
            </div>
            <div id="contentInvoice">
              <%if(!listInvoiceInfor||listInvoiceInfor.length===0){%>
              <p>Chưa có thông tin xuất hóa đơn</p>
              <%}else{%>
                <%listInvoiceInfor.forEach((da)=>{%>
                <div data-idInvoiceInfor="<%=da._id%>">
                  <p><span>Tên công ty:</span> <%=da.nameCompany%></p>
                  <p><span>Mã số thuế:</span> <%=da.mstCompany%></p>
                  <p><span>Địa chỉ:</span> <%=da.addressCompany%></p>
                  <p><span>Mail nhận hóa đơn:</span> <%=da.mailInvoice%></p>
                  <button type="button" class="btnDeleteInvoice" data-idInvoiceInfor="<%=da._id%>"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <%})%>
              <%}%>
            </div>
            </div>
        </div>
        <div id="divInfoCart">
          <div>
            <h2>Đơn hàng</h2>
            <p>Tạm tính:</p>
            <span id="subTotal"><%=subTotal.toLocaleString('vi-VN')%>đ</span>
            <p>Voucher giảm:</p>
            <span id="discountAmount" data-discount="">0đ</span>
            <p>Thành tiền:</p>
            <span id="finalTotal"><%=subTotal.toLocaleString('vi-VN')%>đ</span>
            <p id="textFreeShip">Miễn phí ship</p>
            <p>Phương thức thanh toán:</p>
            <span id="paymentOrder">--</span>
            <p>Tên người nhận:</p>
            <span id="nameDelivery">--</span>
            <p>Số điện thoại:</p>
            <span id="telDelivery">--</span>
            <p>Địa chỉ:</p>
            <span id="addressDelivery">--</span>
            <p>Tên công ty:</p>
            <span id="nameCompanyOrder">--</span>
            <p>Mã số thuế:</p>
            <span id="mstCompanyOrder">--</span>
            <p>Địa chỉ:</p>
            <span id="addressCompanyOrder">--</span>
            <p>Mail nhận hóa đơn:</p>
            <span id="mailInvoiceOrder">--</span>
            <i>Kiểm tra lại thông tin trước khi tiếp tục bạn nhé!</i>
            <button type="button" id="btnOrder">Thanh toán</button>
          </div>
        </div>
        <%}%>
    </main>
<script src="/socket.io/socket.io.js"></script>
</body>
<script type="module" src="/cart.js" defer></script>
</html>