<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=app.name%></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/img/logo_imzen01-final - 32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/img/logo_imzen01-final - 16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/img/logo_imzen01-final.png" sizes="180x180">
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Geomini-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
</head>
<body>
  <div id="preloader">
      <div id="spinner"></div>
      <p id="loadingText">Đang tải dữ liệu...</p>
    </div>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm">
            <i class="fa-solid fa-check"></i> Xác nhận
          </button>
          <button id="btnDeny">
            <i class="fa-solid fa-xmark"></i> Từ chối
          </button>
        </div>
      </div>
    <header>
      <div>
       <h1>
        <a href="/" class="logo-link">
          <img src="/img/logo_imzen01-final.webp" alt="logo">
          <span>VÂN HY</span>
        </a>
        </h1>
      </div>
      <div>
        <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
       </button>
       <span id="countCartHamburgerBtn">0</span>
      </div>
      <div id="divNavMenu">
        <div id="navMenu">
        <nav>
          <ul>
            <li><a href="/">Trang chủ</a></li>
            <li>
              <a href="/app?sort=createAt" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="/device">Thiết bị</a></li>
            <li><a href="/blogs">Blog</a></li>
            <li><a href="#">Hợp tác</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button type="button" id="btnRegisterClient">Đăng ký</button>
          <button type="button" id="btnLoginClient">Đăng nhập</button>
        </div>
        <div id="containerUserLogin">
          <div id="infoUserLogin">
          <h3>Tên user</h3>
          <div id="groupBtnUserLogin">
            <button id="btnDashboardUserLogin">Dashboard</button>
            <button id="btnLogoutUserLogin">Đăng xuất</button>
          </div>
        </div>
        <div id="bagShopping">
           <i class="fa-brands fa-opencart"></i>
           <span>0</span>
        </div>
        </div>
      </div>
      </div>
    </header>
    <main id="mainDetailApp">
        <div id="headerDetailApp">
          <input type="hidden" name="imgApp" id="imgApp" value="<%=app.image%>">
          <h3><%=app.name%></h3>
          <p id="idApp"><%=app._id%></p>
          <div id="groupBtn">
            <%if(app.priceLE==="Miễn phí"){%>
              <p>Miễn phí</p>
            <%}else{%>
              <p class="statusTrial">Dùng thử 30 ngày</p>
              <button id="btnAddCart" data-idApp="<%=app._id%>" data-nameApp="<%=app.name%>" data-priceApp="<%=app.priceLE%>">Mua ngay</button>
            <%}%>
            <a href="<%=app.instruction%>" target="_blank"><i class="fa-brands fa-youtube"></i> Hướng dẫn sử dụng</a>
          </div>
        </div>
        <div id="bodyDetailApp">
        <p><%-app.info%></p>
        <p><%=app.func%></p>
        <p><%=app.views%></p>
        </div>
    </main>
    <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Danh mục</h3>
          <a href="/" target="_blank">Trang chủ</a><br />
          <a href="/app" target="_blank">Phần mềm</a><br />
          <a href="/device" target="_blank">Thiết bị</a><br />
          <a href="/blogs" target="_blank">Blogs</a><br />
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <form id="formSubscribers">
          <label for="nameSubscribers">Tên</label><br>
          <input type="text" name="nameSubscribers" id="nameSubscribers"><br>
          <label for="emailSubscribers">Email</label><br>
          <input type="email" name="emailSubscribers" id="emailSubscribers"><br>
          <p>Hoặc</p>
          <label for="telSubscribers">Số điện thoại</label><br>
          <input type="tel" name="telSubscribers" id="telSubscribers"><br>
          <input type="submit" value="Đăng ký">
          </form>
        </div>
      </footer>
<script src="/socket.io/socket.io.js"></script>
</body>
<script type="module" src="/detailApp.js" defer></script>
</html>