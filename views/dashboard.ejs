<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>

  </head>
  <body>
    <div class="content">
      <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm"><i class="fa-solid fa-check"></i> Xác nhận</button>
          <button id="btnDeny"><i class="fa-solid fa-xmark"></i> Từ chối</button>
        </div>
      </div>
      <header>
        <div>
          <h1><a href="/">IMZ.AI</a></h1>
        </div>
        <div>
          <nav>
            <ul>
              <li><a href="#">Trang chủ</a></li>
              <li>
                <a href="#" id="navCongCu"
                  >Phần mềm <i class="fa-solid fa-caret-down"></i
                ></a>
                <div id="listNavCongCu">
                  <a href="/todo">To Do List</a><br />
                  <a href="/file">Upper Text</a><br />
                  <a href="#">Ứng dụng 3</a><br />
                </div>
              </li>
              <li><a href="#">Thiết bị</a></li>
              <li><a href="#">Tin tức</a></li>
              <li><a href="#">Q&A</a></li>
            </ul>
          </nav>
          <div id="groupBtn">
            <button>Đăng ký</button>
            <button>Đăng nhập</button>
          </div>
        </div>
      </header>
      <main id="mainDashboard">
        <div id="navDashboard">
          <div>
            <h2 id="fullnameAd">Tên user</h2>
            <h3 id="roleAd">Chức vụ</h3>
            <em id="idAd"></em>
          </div>
          <button data-target="workMng" class="navBtnDB active">
            <i class="fa-regular fa-clipboard"></i> Quản lý công việc
          </button>
          <button data-target="serverMng" class="navBtnDB">
            <i class="fa-solid fa-server"></i> Quản lý server
          </button>
          <button data-target="userMng" class="navBtnDB">
            <i class="fa-solid fa-user"></i> Quản lý user
          </button>
          <button data-target="softwareMng" class="navBtnDB">
            <i class="fa-solid fa-code"></i> Quản lý phần mềm
          </button>
          <button data-target="deviceMng" class="navBtnDB">
            <i class="fa-solid fa-screwdriver-wrench"></i> Quản lý thiết bị
          </button>
          <button data-target="newsMng" class="navBtnDB">
            <i class="fa-regular fa-newspaper"></i> Quản lý tin tức
          </button>
          <button data-target="qaMng" class="navBtnDB">
            <i class="fa-solid fa-circle-question"></i> Quản lý Q&A
          </button>
           <button data-target="passwordMng" class="navBtnDB">
            <i class="fa-solid fa-key"></i> Cập nhật mật khẩu
          </button>
        </div>
        <div id="contentDashboard">
          <div id="workMng" class="tabContent active">
            <h2>Nội dung quản lý công việc</h2>
          </div>
          <div id="serverMng" class="tabContent">
            <h2>1.Thông tin server</h2>
            <pre><%=jsonSystemInfo%></pre>
          </div>
          <div id="userMng" class="tabContent">
            <h2>1.Tài khoản quản trị</h2>
            <form id="registerAdmin">
              <input type="hidden" name="idAdmin" id="idAdminHidden">
              <label for="fullnameAdmin">Họ và tên</label>
              <input type="text" name="fullnameAdmin" id="fullnameAdmin">
              <label for="roleAdmin">Chức vụ</label>
              <input type="text" name="roleAdmin" id="roleAdmin">
              <label for="emailAdmin">Email (abc123@imz.ai)</label><br />
              <input type="email" name="emailAdmin" id="emailAdmin" /><br />
              <label for="pwAdmin">Password</label><br />
              <input type="text" name="pwAdmin" id="pwAdmin" /><br />
              <em>*Mật khẩu tối thiểu 8 ký tự</em><br />
              <em>*Mật khẩu tối thiểu 1 chữ cái, 1 chữ số, 1 ký tự đặc biệt</em>
              <p>Phân quyền</p>
              <div id="formDecentralize">
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentWork"
                  value="workMng"
                />
                <label for="decentWork">Quản lý công việc</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentServer"
                  value="serverMng"
                />
                <label for="decentServer">Quản lý server</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentUser"
                  value="userMng"
                />
                <label for="decentUser">Quản lý user</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentTool"
                  value="softwareMng"
                />
                <label for="decentTool">Quản lý phần mềm</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentProduct"
                  value="deviceMng"
                />
                <label for="decentProduct">Quản lý thiết bị</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentNews"
                  value="newsMng"
                />
                <label for="decentNews">Quản lý tin tức</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentFeedBack"
                  value="qaMng"
                />
                <label for="decentFeedBack">Quản lý Q&A</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentChangePW"
                  value="passwordMng"
                />
                <label for="decentChangePW">Thay đổi mật khẩu</label><br />
              </div>
              <button type="submit" id="btnRegister">Đăng ký</button>
            </form>
            <div id="divTableUserAdmin">
              <table id="tableUserAdmin">
              <tr>
                <th>Họ và tên</th>
                <th>Chức vụ</th>
                <th>Email</th>
                <th>Phân quyền</th>
                <th>Thao tác</th>
              </tr>
              <%admins.forEach(admin=>{%>
              <tr>
                <td><%=admin.fullname%></td>
                <td><%=admin.role%></td>
                <td><%=admin.email%></td>
                <td><%=admin.decent%></td>
                <td>
                  <button class="btnEditUserAdmin" data-idAdmin="<%=admin._id%>">Cập nhật</button>
                  <button class="btnDeleteUserAdmin" data-idAdmin="<%=admin._id%>">Xóa</button>
                </td>
              </tr>
              <%})%>
            </table>
            </div>
          
          </div>
          <div id="softwareMng" class="tabContent">
            <h2>Nội dung quản lý phần mềm</h2>
          </div>
          <div id="deviceMng" class="tabContent">
            <h2>Nội dung quản lý thiết bị</h2>
          </div>
          <div id="newsMng" class="tabContent">
            <h2>Nội dung quản lý tin tức</h2>
          </div>
          <div id="qaMng" class="tabContent">
            <h2>Nội dung quản lý Q&A</h2>
          </div>
          <div id="passwordMng" class="tabContent">
            <h2>Thay đổi mật khẩu</h2>
            <from>
              <label for="pwAdminNew">Mật khẩu mới</label><br>
              <input type="password" id="pwAdminNew">
              <button id="btnTogglePW"><i class="fa-solid fa-eye"></i></button><br>
              <button id="btnUpdatePW">Cập nhật</button>
            </from>
          </div>
        </div>
      </main>
      <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZ</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/logo_tiktok.avif" alt="logo_youtube" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Công cụ</h3>
          <a href="/">To Do List</a><br />
          <a href="/">Ứng dụng 2</a><br />
          <a href="/">Ứng dụng 3</a><br />
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
    </div>
  </body>
  <script type="module" src="/dashboard.js" defer></script>
</html>
