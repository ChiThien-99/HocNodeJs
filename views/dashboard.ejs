<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/scrapooo/quill-resize-module@1.0.2/dist/quill-resize-module.js"></script>
<link href="https://cdn.jsdelivr.net/npm/quill-table-better@1/dist/quill-table-better.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/quill-table-better@1/dist/quill-table-better.js"></script>
  </head>
  <body>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm"><i class="fa-solid fa-check"></i> Xác nhận</button>
          <button id="btnDeny"><i class="fa-solid fa-xmark"></i> Từ chối</button>
        </div>
      </div>
      <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" />
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <div id="navMenu">
        <h2>Khu vực quản trị</h2>
      </div>
    </header>
      <main id="mainDashboard">
        <div id="navDashboard">
          <div>
            <h2 id="fullnameAd">Tên user</h2>
            <h3 id="roleAd">Chức vụ</h3>
            <em id="idAd"></em>
          </div>
          <button data-target="orderMng" class="navBtnDB active">
            <i class="fa-solid fa-boxes-packing"></i> Quản lý đơn hàng
          </button>
          <button data-target="workMng" class="navBtnDB">
            <i class="fa-regular fa-clipboard"></i> Quản lý công việc
          </button>
          <button data-target="serverMng" class="navBtnDB">
            <i class="fa-solid fa-server"></i> Quản lý server
          </button>
          <button data-target="userMng" class="navBtnDB">
            <i class="fa-solid fa-user"></i> Quản lý user
          </button>
          <button data-target="homeMng" class="navBtnDB">
            <i class="fa-solid fa-house"></i> Quản lý trang chủ
          </button>
          <button data-target="marketingMng" class="navBtnDB">
            <i class="fa-solid fa-rectangle-ad"></i> Quản lý marketing
          </button>
          <button data-target="softwareMng" class="navBtnDB">
            <i class="fa-solid fa-code"></i> Quản lý phần mềm
          </button>
          <button data-target="deviceMng" class="navBtnDB">
            <i class="fa-solid fa-screwdriver-wrench"></i> Quản lý thiết bị
          </button>
          <button data-target="blogsMng" class="navBtnDB">
            <i class="fa-regular fa-newspaper"></i> Quản lý blog
          </button>
           <button data-target="passwordMng" class="navBtnDB">
            <i class="fa-solid fa-key"></i> Cập nhật mật khẩu
          </button>
        </div>
        <div id="contentDashboard">
          <div id="orderMng" class="tabContent active">
            <h2 class="flag-item">Quản lý đơn hàng</h2>
            <table>
              <thead>
                 <tr>
                <th>Đơn hàng</th>
                <th>Người mua</th>
                <th>Thành tiền</th>
                <th>Hóa đơn</th>
                <th>Tình trạng</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
                <%orders.forEach((order)=>{%>
                  <tr data-idOrder="<%=order._id%>">
                  <td><%=order.orderNumber%></td>
                  <td><%=order.nameCompany==="--"?order.buyer:order.nameCompany%></td>
                  <td>
                    <%let subtotal=0;%>
                    <%=order.products.forEach((p)=>{subtotal+=p.quantity*p.price;})%>
                    <%=(subtotal-order.voucherDiscount).toLocaleString("vi-VN")%>
                  </td>
                  <td>
                    <input type="text" name="invoice" id="invoice">
                  </td>
                  <td>
                    <select name="status" id="status">
                      <option value="processOrder">Đang xử lý</option>
                      <option value="transitOrder">Đang vận chuyển</option>
                      <option value="receivedOrder">Đã nhận hàng</option>
                      <option value="cancleOrder">Hủy</option>
                    </select>
                  </td>
                  <td>
                    <button type="button" id="btnEditOrder">Chỉnh sửa</button>
                    <button type="button" id="btnDetailOrder">Chi tiết</button>
                  </td>
                </tr>
                <%})%>
              </tbody>
            </table>
          </div>
          <div id="workMng" class="tabContent">
            <h2>Nội dung quản lý công việc</h2>
          </div>
          <div id="serverMng" class="tabContent">
            <h2 class="flag-item">Thông tin server</h2>
            <pre><%=jsonSystemInfo%></pre>
          </div>
          <div id="userMng" class="tabContent">
            <h2 class="flag-item">Tài khoản quản trị</h2>
            <form id="registerAdmin">
              <input type="hidden" name="idAdmin" id="idAdminHidden">
              <label for="fullnameAdmin">Họ và tên</label>
              <input type="text" name="fullnameAdmin" id="fullnameAdmin">
              <label for="roleAdmin">Chức vụ</label>
              <input type="text" name="roleAdmin" id="roleAdmin">
              <label for="emailAdmin">Email (abc123@imz.ai)</label><br />
              <input type="email" name="emailAdmin" id="emailAdmin" /><br />
              <label for="pwAdmin">Password</label><br />
              <input type="text" name="pwAdmin" id="pwAdmin" /><br />
              <em>*Mật khẩu tối thiểu 8 ký tự</em><br />
              <em>*Mật khẩu tối thiểu 1 chữ cái, 1 chữ số, 1 ký tự đặc biệt</em>
              <p>Phân quyền</p>
              <div id="formDecentralize">
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentOrder"
                  value="orderMng"
                />
                <label for="decentOrder">Quản lý đơn hàng</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentWork"
                  value="workMng"
                />
                <label for="decentWork">Quản lý công việc</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentServer"
                  value="serverMng"
                />
                <label for="decentServer">Quản lý server</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentUser"
                  value="userMng"
                />
                <label for="decentUser">Quản lý user</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentHome"
                  value="homeMng"
                />
                <label for="decentHome">Quản lý trang chủ</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentBanner"
                  value="marketingMng"
                />
                <label for="decentBanner">Quản lý marketing</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentTool"
                  value="softwareMng"
                />
                <label for="decentTool">Quản lý phần mềm</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentProduct"
                  value="deviceMng"
                />
                <label for="decentProduct">Quản lý thiết bị</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentblogs"
                  value="blogsMng"
                />
                <label for="decentblogs">Quản lý blog</label><br />
                <input
                  type="checkbox"
                  name="decentAdmin"
                  id="decentChangePW"
                  value="passwordMng"
                />
                <label for="decentChangePW">Thay đổi mật khẩu</label><br />
              </div>
              <button type="submit" id="btnRegister">Đăng ký</button>
            </form>
            <div id="divTableUserAdmin">
              <table id="tableUserAdmin">
              <tr>
                <th>Họ và tên</th>
                <th>Chức vụ</th>
                <th>Email</th>
                <th>Phân quyền</th>
                <th>Thao tác</th>
              </tr>
              <%admins.forEach(admin=>{%>
              <tr>
                <td><%=admin.fullname%></td>
                <td><%=admin.role%></td>
                <td><%=admin.email%></td>
                <td><%=admin.decent%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnEditUserAdmin" data-idAdmin="<%=admin._id%>">Cập nhật</button>
                  <button class="btnDeleteUserAdmin" data-idAdmin="<%=admin._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
            </table>
            </div>
          
          </div>
          <div id="homeMng" class="tabContent">
            <h2 class="flag-item">Quản lý carousel</h2>
            <form id="formCarousel" enctype="multipart/form-data">
            <input type="hidden" name="idCarousel" id="idCarousel">
            <label for="imageCarousel">Hình ảnh banner</label><br>
            <input type="file" name="imageCarousel" id="imageCarousel" accept="image/webp">
            <button type="button" id="btnDeleteImgCarousel">Xóa hình</button><br>
            <label for="captionBanner">Caption banner</label><br>
            <input type="text" name="captionCarousel" id="captionCarousel" required><br>
            <label for="urlCarousel">Đường dẫn banner</label><br>
            <input type="text" name="urlCarousel" id="urlCarousel" required><br>
            <label for="orderCarousel">Order</label><br>
            <input type="number" name="orderCarousel" id="orderCarousel" required><br>
            <input type="submit" id="btnAddCarousel" value="Tạo">
            <button type="button" id="btnCancelCarousel">Hủy</button>
            </form>
            <em>Lưu ý: Nếu sai hình ảnh hãy xóa luôn banner và tạo mới</em>
            <div id="divTableCarousel">
              <table id="tableCarousel">
              <thead>
                <tr>
                <th>Caption</th>
                <th>Url</th>
                <th>Order</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
              <%carousels.forEach((carousel)=>{%>
              <tr data-idCarousel="<%=carousel._id%>">
                <td><%=carousel.caption%></td>
                <td><%=carousel.url%></td>
                <td><%=carousel.order%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnUpdateCarousel" data-idCarousel="<%=carousel._id%>">Cập nhật</button>
                  <button class="btnDeleteCarousel" data-idCarousel="<%=carousel._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý thông báo</h2>
            <form id="formAddNotify">
              <input type="hidden" name="idNotify" id="idNotify">
              <label for="typeNotify">Loại thông báo</label><br>
              <select name="typeNotify" id="typeNotify">
                <option value="all">Tất cả</option>
                 <option value="system">Hệ thống</option>
                 <option value="event">Sự kiện</option>
                 <option value="app">Phần mềm</option>
                 <option value="device">Thiết bị</option>
                 <option value="blogs">Blog</option>
              </select><br>
              <label for="contentNotify">Nội dung thông báo</label><br>
              <input type="text" name="contentNotify" id="contentNotify"><br>
              <label for="urlNotify">Đường dẫn</label><br>
              <input type="text" name="urlNotify" id="urlNotify"><br>
              <label for="expiredNotify">Thời gian hết hạn</label><br>
              <input type="datetime-local" name="expiredNotify" id="expiredNotify"><br>
              <input type="submit" id="btnNotify" value="Tạo">
              <button type="button" id="btnCancelNotify">Hủy</button>
            </form>
            <div id="divTableNotify">
            <table id="tableNotify">
              <thead>
                <tr>
                <th>Loại thông báo</th>
                <th>Nội dung thông báo</th>
                <th>Đường dẫn</th>
                <th>Hết hạn</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
              <%notifys.forEach(notify=>{%>
              <tr data-idnotify="<%=notify._id%>">
                <td><%=notify.type%></td>
                <td><%=notify.content%></td>
                <td><%=notify.url%></td>
                <td><%=new Date(notify.expireAt).toLocaleString("vi-VN")%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnUpdateNotify" data-idnotify="<%=notify._id%>">Cập nhật</button>
                  <button class="btnDeleteNotify" data-idnotify="<%=notify._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý problem</h2>
            <form id="formProblem">
              <label for="name">Tên</label>
              <input type="text" name="name" id="name">
              <label for="contentProblem">Vấn đề</label>
              <textarea name="contentProblem" id="contentProblem"></textarea>
            </form>
            <div id="divTableProblem">
              <table id="tableProblem">
                <thead>
                  <tr>
                    <th>Tên</th>
                    <th>Vấn đề</th>
                    <th>Ngày</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  <%problems.forEach((problem)=>{%>
                  <tr data-idProblem="<%=problem._id%>">
                    <td><%=problem.name%></td>
                    <td><%=problem.content%></td>
                    <td><%=new Date(problem.createAt).toLocaleString("vi-VN")%></td>
                    <td>
                      <button type="button" class="btnWatchProblem" data-idProblem="<%=problem._id%>">Xem</button>
                      <button type="button" class="btnDeleteProblem" data-idProblem="<%=problem._id%>">Xóa</button>
                    </td>
                  </tr>
                  <%})%>
                </tbody>
              </table>
            </div>
          </div>
          <div id="marketingMng" class="tabContent">
            <h2 class="flag-item">Quản lý banner</h2>
            <form id="formBanner">
              <input type="hidden" name="idBN" id="idBN">
              <label for="pageBanner">Trang</label><br>
              <select name="pageBanner" id="pageBanner">
                <option value="app">Phần mềm</option>
                <option value="device">Thiết bị</option>
                <option value="blog">Blog</option>
              </select><br>
              <label for="imgBanner">Hình ảnh</label><br>
              <input type="file" name="imgBanner" id="imgBanner">
              <button type="button" id="btnDeleteImgBN">Xóa hình</button><br>
              <label for="urlBN">URL</label><br>
              <input type="text" name="urlBN" id="urlBN"><br>
              <input type="submit" value="Tạo" id="btnBanner">
              <button type="button" id="btnCancleBN">Hủy</button><br>
            </form>
            <div id="divTableBN">
              <table id="tableBN">
                <thead>
                <tr>
                <th>Trang</th>
                <th>Url</th>
                <th>Thao tác</th>
                </tr>
                </thead>
                <tbody>
                  <%bns.forEach((bn)=>{%>
                <tr data-idBN="<%=bn._id%>">
                <td><%=bn.page%></td>
                <td><%=bn.url%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnUpdateBN" data-idBN="<%=bn._id%>">Cập nhật</button>
                  <button class="btnDeleteBN" data-idBN="<%=bn._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
                </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý voucher</h2>
            <form id="formVoucher">
              <label for="genderClient">Giới tính khách hàng</label><br>
              <select name="genderClient" id="genderClient">
                <option value="all">Tất cả</option>
                <option value="male">Nam</option>
                <option value="female">Nữ</option>
              </select><br>
              <label for="genderClient">Sản phẩm áp dụng</label><br>
              <select name="categoryVoucher" id="categoryVoucher">
                <option value="all">Tất cả</option>
                <option value="app">Phần mềm</option>
                <option value="device">Thiết bị</option>
              </select><br>
              <label for="imgVoucher">Hình ảnh</label><br>
              <input type="file" name="imgVoucher" id="imgVoucher"><br>
              <label for="titleVoucher">Tiêu đề</label><br>
              <input type="text" name="titleVoucher" id="titleVoucher"><br>
              <label for="contentVoucher">Nội dung</label><br>
              <div class="quill-editor"></div>
              <input type="hidden" name="contentVoucher" id="contentVoucher">
              <label for="discountPerVoucher">% giảm giá</label><br>
              <input type="number" name="discountPerVoucher" id="discountPerVoucher"><br>
              <input type="submit" value="Tạo" id="btnAddVoucher">
            </form>
          </div>
          <div id="softwareMng" class="tabContent">
            <h2 class="flag-item">Quản lý chức năng phần mềm</h2>
            <form action="" id="formFuncApp">
              <input type="hidden" name="idFuncApp" id="idFuncApp">
              <label for="listFuncApp">Chức năng phần mềm</label><br>
              <input type="text" name="listFuncApp" id="listFuncApp"><br>
              <input type="submit" value="Tạo" id="btnFuncApp">
              <button type="button" id="btnCancelFuncApp">Hủy</button>
            </form>
            <div id="divTableFuncApp">
              <table id="tableFuncApp">
                <thead>
                 <tr>
                  <th>Tên chức năng</th>
                  <th>Thao tác</th>
                 </tr>
                </thead>
             <tbody>
                <%listFuncApp.forEach((funcApp)=>{%>
              <tr data-idFuncApp="<%=funcApp._id%>">
                <td><%=funcApp.name%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnUpdateFuncApp" data-idfuncapp="<%=funcApp._id%>">Cập nhật</button>
                  <button class="btnDeleteFuncApp" data-idfuncapp="<%=funcApp._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
             </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý phần mềm</h2>
            <form enctype="multipart/form-data" id="formApp">
              <input type="hidden" name="idApp" id="idApp">
              <label for="imgApp">Hình ảnh</label><br>
              <input type="file" accept="image/webp" name="imgApp" id="imgApp">
              <button type="button" id="btnDeleteImgApp">Xóa hình</button><br>
              <label for="nameApp">Tên phần mềm (Không chứa khoảng trắng)</label><br>
              <input type="text" name="nameApp" id="nameApp"><br>
              <label for="infoApp">Thông tin phần mềm</label><br>
              <div class="quill-editor"></div>
              <input type="hidden" name="infoApp" id="infoApp">
              <label for="optionPrice">Giá</label><br>
              <select name="optionPrice" id="optionPrice">
                <option value="freeApp">Miễn phí</option>
                <option value="hasPriceApp">Giá</option>
              </select><br>
              <div id="divPriceLEApp">
              <label for="priceLEApp">Giá lẻ</label><br>
              <input type="text" name="priceLEApp" id="priceLEApp"><br>
              <input type="hidden" name="priceLEActualApp" id="priceLEActualApp">
              </div>
              <div id="divPriceSIApp">
              <label for="priceSIApp">Giá sỉ</label><br>
              <input type="text" name="priceSIApp" id="priceSIApp"><br>
              <input type="hidden" name="priceSIActualApp" id="priceSIActualApp">
              </div>
              <label for="funcApp">Chức năng</label><br>
              <select name="funcApp" id="funcApp" multiple>
                <%listFuncApp.forEach((funcApp)=>{%>
                <option value="<%=funcApp.name%>" data-optionFuncAppID="<%=funcApp._id%>"><%=funcApp.name%></option>
                <%})%>
              </select><br>
              <label for="instructionApp">Video hướng dẫn</label><br>
              <input type="text" name="instructionApp" id="instructionApp"><br>
              <input type="submit" id="btnApp" value="Tạo">
              <button type="button" id="btnCancelApp">Hủy</button>
            </form>
            <em>Lưu ý: Nếu sai hình ảnh hãy xóa luôn app và tạo mới</em>
            <div id="divTableApp">
              <table id="tableApp">
              <thead>
                <tr>
                <th>Tên phần mềm</th>
                <th>Chức năng</th>
                <th>Giá lẻ</th>
                <th>Giá sỉ</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
                 <%apps.forEach((app)=>{%>
              <tr data-idapp="<%=app._id%>">
                <td><%=app.name%></td>
                <td><%=app.func%></td>
                <%if(app.priceLE==="Miễn phí"&&app.priceSI==="Miễn phí"){%>
                  <td><%=app.priceLE%></td>
                  <td><%=app.priceSI%></td>
                <%}else{%>
                  <td><%=Number(app.priceLE).toLocaleString('vi-VN')%>đ</td>
                  <td><%=Number(app.priceSI).toLocaleString('vi-VN')%>đ</td>
                <%}%>
                <td><%=new Date(app.createAt).toLocaleString("vi-VN")%></td>
                <td>
                  <div class="btnGroup">
                    <button class="btnUpdateApp" data-idapp="<%=app._id%>">Cập nhật</button>
                    <button class="btnDeleteApp" data-idapp="<%=app._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
              
            </table>
            </div>
            
          </div>
          <div id="deviceMng" class="tabContent">
            <h2 class="flag-item">Quản lý chức năng thiết bị</h2>
            <form id="formFuncDevice">
              <input type="hidden" name="idFuncDevice" id="idFuncDevice">
              <label for="listFuncDevice">Chức năng thiết bị</label><br>
              <input type="text" name="listFuncDevice" id="listFuncDevice"><br>
              <input type="submit" value="Tạo" id="btnFuncDevice">
              <button type="button" id="btnCancleFuncDevice">Hủy</button>
            </form>
            <div id="divTableFuncDevice">
                <table id="tableFuncDevice">
              <thead>
                <tr>
                <th>Tên chức năng</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
                <%listFuncDevice.forEach((funcDevice)=>{%>
              <tr data-rowId="<%=funcDevice._id%>">
                <td class="cellNameDevice"><%=funcDevice.name%></td>
                <td>
                  <div class="btnGroup">
                  <button class="btnUpdateFuncDevice" data-idfuncdevice="<%=funcDevice._id%>">Cập nhật</button>
                  <button class="btnDeleteFuncDevice" data-idfuncdevice="<%=funcDevice._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý thiết bị</h2>
            <form enctype="multipart/form-data" id="formDevice">
              <input type="hidden" name="idDevice" id="idDevice">
              <label for="imgDevice">Hình ảnh</label><br>
              <input type="file" accept="image/webp" name="imgDevice" class="imgDevice" multiple>
              <button type="button" id="deleteImageDevice">Xóa hình</button><br>
              <label for="nameDevice">Tên thiết bị (Không chứa khoảng trắng)</label><br>
              <input type="text" name="nameDevice" id="nameDevice"><br>
              <label for="infoDevice">Nội dung thiết bị (Gồm 3 phần H3: Thông số-Chức năng-Thông tin)</label><br>
              <div class="quill-editor"></div>
              <input type="hidden" name="infoDevice" id="infoDevice">
              <label for="">Màu sắc</label>
              <div id="color-container">
                <div class="color-row">
                  <input type="text" name="colorNames" class="colorNames" placeholder="VD:Đen">
                  <input type="number" name="colorIndex" class="colorIndex" placeholder="Nhập index">
                  <input type="file" class="imgDevice" name="colorImg" accept="image/webp">
                  <button type="button" class="btnRemoveColor">Xóa</button>
                </div>
              </div>
              <button type="button" id="btnAddColor">Thêm màu</button>
              <button type="button" id="deleteImageColor">Xóa hình</button><br>
              <label for="priceDevice">Giá lẻ</label><br>
              <input type="text" name="priceLEDevice" id="priceLEDevice"><br>
              <input type="hidden" name="priceLEDeviceActual" id="priceLEDeviceActual">
              <label for="priceDevice">Giá sỉ</label><br>
              <input type="text" name="priceSIDevice" id="priceSIDevice"><br>
              <input type="hidden" name="priceSIDeviceActual" id="priceSIDeviceActual">
              <label for="funcDevice">Chức năng</label><br>
              <select name="funcDevice" id="funcDevice" multiple>
                <%listFuncDevice.forEach((funcDevice)=>{%>
                <option value="<%=funcDevice.name%>" data-optionFuncDVID="<%=funcDevice._id%>"><%=funcDevice.name%></option>
                <%})%>
              </select><br>
              <label for="instrucDevice">Video hướng dẫn</label><br>
              <input type="text" name="instrucDevice" id="instrucDevice"><br>
              <input type="submit" id="btnDevice" value="Tạo">
              <button type="button" id="btnCancelDevice">Hủy</button>
            </form>
            <em>Lưu ý: Nếu sai hình ảnh hãy xóa luôn thiết bị và tạo mới</em>
            <div id="divTableDevice">
              <table id="tableDevice">
                <thead>
                <tr>
                <th>Tên thiết bị</th>
                <th>Giá lẻ</th>
                <th>Giá sỉ</th>
                <th>Chức năng</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
                </tr>
                </thead>
                <tbody>
                   <%devices.forEach((device)=>{%>
              <tr data-rowId="<%=device._id%>">
                <td><%=device.name%></td>
                <td><%=device.priceLE.toLocaleString('vi-VN')%>đ</td>
                <td><%=device.priceSI.toLocaleString('vi-VN')%>đ</td>
                <td><%=device.func%></td>
                <td><%=new Date(device.createAt).toLocaleString('vi-VN')%></td>
                <td>
                  <div class="btnGroup">
                    <button class="btnUpdateDevice" data-iddevice="<%=device._id%>">Cập nhật</button>
                    <button class="btnDeleteDevice" data-iddevice="<%=device._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
                </tbody>
            </table>
            </div>
          </div>
          <div id="blogsMng" class="tabContent">
            <h2 class="flag-item">Quản lý danh mục blog</h2>
            <form id="formCategoryblogs">
              <input type="hidden" name="idCategoryblogs" id="idCategoryblogs">
              <label for="listCategoryblogs">Danh mục blog</label><br>
              <input type="text" name="listCategoryblogs" id="listCategoryblogs"><br>
              <input type="submit" value="Tạo" id="btnCategoryblogs">
              <button type="button" id="btnCancleUDCategory">Hủy</button>
            </form>
            <div id="divTableCategoryblogs">
              <table id="tableCategoryblogs">
              <thead>
                <tr>
                <th>Danh mục</th>
                <th>Thao tác</th>
              </tr>
              </thead>
              <tbody>
                <%listCategoryblogs.forEach((categoryblogs)=>{%>
              <tr data-idCategoryblogs="<%=categoryblogs._id%>">
                <td><%=categoryblogs.name%></td>
                <td>
                  <div class="btnGroup">
                    <button class="btnUpdateCategoryblogs" data-idnCategoryblogs="<%=categoryblogs._id%>">Cập nhật</button>
                    <button class="btnDeleteCategoryblogs" data-idCategoryblogs="<%=categoryblogs._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
            <h2 class="flag-item">Quản lý blog</h2>
            <form enctype="multipart/form-data" id="formblogs">
              <input type="hidden" name="idblogs" id="idblogs">
              <label for="imgblogs">Hình ảnh</label><br>
              <input type="file" accept="image/webp" name="imgblogs" id="imgblogs">
              <button type="button" id="btnDeleteImgBlog">Xóa hình</button><br>
              <label for="titleblogs">Tiêu đề blog</label><br>
              <input type="text" name="titleblogs" id="titleblogs"><br>
              <label for="infoblogs">Nội dung blog</label><br>
              <div class="quill-editor"></div>
              <input type="hidden" name="infoblogs" id="infoblogs">
              <label for="categoryblogs">Danh mục blog</label><br>
              <select name="categoryblogs" id="categoryblogs" multiple>
                <%listCategoryblogs.forEach((categoryblogs)=>{%>
                <option value="<%=categoryblogs.name%>"><%=categoryblogs.name%></option>
                <%})%>
              </select><br>
              <input type="submit" id="btnblogs" value="Tạo">
              <button type="button" id="btnPostDraft">Đăng</button>
              <button type="button" id="btnSaveDraft">Lưu nháp</button>
              <button type="button" id="btnCancleBlog">Hủy</button>
            </form>
            <em>Lưu ý: Nếu sai hình ảnh hãy xóa luôn blog và tạo mới</em><br><br>
            <b>Blogs nháp</b>
            <div id="divTableBlogsDraft">
              <table id="tableBlogsDraft">
                <thead>
                   <tr>
                <th>Tiêu đề blog</th>
                <th>Danh mục</th>
                <th>Thao tác</th>
              </tr>
                </thead>
              <tbody>
                 <%listblogsdraft.forEach((blogsdraft)=>{%>
              <tr data-idblogsdraft="<%=blogsdraft._id%>">
                <td><%=blogsdraft.title%></td>
                <td><%=blogsdraft.category%></td>
                <td>
                  <div class="btnGroup">
                    <button class="btnEditBlogsDraft" data-idblogsdraft="<%=blogsdraft._id%>">Chỉnh sửa</button>
                    <button class="btnDeleteBlogsDraft" data-idblogsdraft="<%=blogsdraft._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
            <b>Blogs đã đăng</b>
             <div id="divTableblogs">
              <table id="tableblogs">
                <thead>
                   <tr>
                <th>Tiêu đề blog</th>
                <th>Danh mục</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
              </tr>
                </thead>
              <tbody>
                 <%listblogs.forEach((blogs)=>{%>
              <tr data-idblogs="<%=blogs._id%>">
                <td><%=blogs.title%></td>
                <td><%=blogs.category%></td>
                <td><%=new Date(blogs.createAt).toLocaleString("vi-VN")%></td>
                <td>
                  <div class="btnGroup">
                    <button class="btnUpdateblogs" data-idblogs="<%=blogs._id%>">Cập nhật</button>
                    <button class="btnDeleteblogs" data-idblogs="<%=blogs._id%>">Xóa</button>
                  </div>
                </td>
              </tr>
              <%})%>
              </tbody>
            </table>
            </div>
          </div>
          <div id="shareMng" class="tabContent">
            <h2>Nội dung quản lý chia sẻ</h2>
          </div>
          <div id="passwordMng" class="tabContent">
            <h2 class="flag-item">Thay đổi mật khẩu</h2>
            <from>
              <label for="pwAdminNew">Mật khẩu mới</label><br>
              <input type="password" id="pwAdminNew">
              <button id="btnTogglePW"><i class="fa-solid fa-eye"></i></button><br>
              <button id="btnUpdatePW">Cập nhật</button>
            </from>
          </div>
        </div>
      </main>
      <script src="/socket.io/socket.io.js"></script>
  </body>
  <script type="module" src="/dashboard.js" defer></script>
</html>
