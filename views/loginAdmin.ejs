<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="icon"
      href="/img/logo_imzen01-final - 32x32.png"
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href="/img/logo_imzen01-final - 16x16.png"
      type="image/png"
      sizes="16x16"
    />
    <link
      rel="apple-touch-icon"
      href="/img/logo_imzen01-final.png"
      sizes="180x180"
    />
    <link
      rel="shortcut icon"
      href="/img/logo_imzai_1.ico"
      type="image/x-icon"
    />
    <link
      rel="preload"
      href="/Geomini-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div id="alert">
      <h4 id="headingAlert">Tiêu đề thông báo</h4>
      <p id="contentAlert">Thông báo lần 1</p>
    </div>
    <div id="myModalLoginAdmin">
      <div id="modalContentLoginAdmin">
        <p>
          Nhập mã OTP từ Google Authenticator hoặc Microsoft Authenticator để
          đăng nhập
        </p>
        <form id="formOtpLoginAdmin">
          <input type="hidden" name="adminId" id="adminId" />
          <input type="text" name="otpCodeLoginAdmin" id="otpCodeLoginAdmin" required />
          <input type="submit" value="Đăng nhập" />
        </form>
      </div>
    </div>
    <div id="logoLogin">
      <h1>
        <a href="/" class="logo-link">
          <img src="/img/logo_imzen01-final.webp" alt="logo" />
          <span>VÂN HY</span>
        </a>
      </h1>
    </div>
    <div id="loginContainer">
      <form id="loginForm" method="post">
        <h2>Đăng nhập dành cho quản trị viên</h2>
        <div>
          <label for="emailAdmin">Email</label><br />
          <input type="email" name="emailAdmin" id="emailAdmin" />
        </div>
        <div>
          <label for="pwAdmin">Mật khẩu</label><br />
          <input type="password" name="pwAdmin" id="pwAdmin" />
          <button id="togglePwAdmin">
            <i class="fa-solid fa-eye"></i>
          </button>
        </div>
        <button type="submit" id="btnSubmitAdmin">Đăng nhập</button><br />
        <em id="messLoginAdmin">
          Số lần đăng nhập còn lại <span id="remainingRate">--</span>/<span
            id="limitRate"
            >--</span
          >
        </em>
        <div id="rateLimitAlert">
          <strong>Quá nhiều lần thử !</strong>
          <p id="remainingTime">Vui lòng chờ...</p>
        </div>
      </form>
    </div>
  </body>
  <script type="module" src="/loginAdmin.js" defer></script>
</html>
