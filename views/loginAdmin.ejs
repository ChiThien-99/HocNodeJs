<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="logoLogin">
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -49,75 A 85,85 0 1,1 121,75 A 85,85 0 1,1 -49,75" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-39" y="0" width="150" height="150" clip-path="circle()" />
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <div id="loginContainer">
        <form id="loginForm" method="post">
          <h2>Đăng nhập dành cho quản trị viên</h2>
          <div>
            <label for="emailAdmin">Email</label><br />
            <input type="email" name="emailAdmin" id="emailAdmin" />
          </div>
          <div>
            <label for="pwAdmin">Mật khẩu</label><br />
            <input type="password" name="pwAdmin" id="pwAdmin" />
            <button id="togglePwAdmin">
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>
          <button type="submit" id="btnSubmitAdmin">Đăng nhập</button><br />
          <em id="messLoginAdmin">
            Số lần đăng nhập còn lại <span id="remainingRate">--</span>/<span
              id="limitRate"
              >--</span
            >
          </em>
          <div id="rateLimitAlert">
            <strong>Quá nhiều lần thử !</strong>
            <p id="remainingTime">Vui lòng chờ...</p>
          </div>
        </form>
      </div>
  </body>
  <script type="module" src="/loginAdmin.js" defer></script>
</html>
