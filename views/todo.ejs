<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToDoList</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
    <link rel="preload" href="/Minecraft.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/OpenSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <script src="https://kit.fontawesome.com/c1f12001f0.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="content">
<header>
        <div>
            <h1><a href="/">IMZ.AI</a></h1>
        </div>
        <div>
            <nav>
                <ul>
                    <li><a href="#">Trang chủ</a></li>
                    <li>
                        <a href="#" id="navCongCu">Công cụ <i class="fa-solid fa-caret-down"></i></a>
                    </li>
                    <li><a href="#">Tin tức</a></li>
                    <li><a href="#">Góp ý</a></li>
                </ul>
            </nav>
            <div id="groupBtn">
                <button>Đăng ký</button>
                <button>Đăng nhập</button>
            </div>
            
        </div>
    </header>
    <div id="addTask">
        <p style="display: none;" id="idTask"></p>
        <input type="text" placeholder="Điền công việc của bạn" id="inpTask">
        <button id="btnTask">Thêm công việc</button>
    </div>
    
    <div id="todolist">
        <%todolist.forEach(item=>{%>
        <div class="item <%=item.complete?'complete':''%>" data-id="<%=item.id%>">
            <p><%=item.task%></p>
            <div class="btnGroup">
              <button class="btnComplete" data-id="<%=item.id%>"><i class="fa-solid fa-check"></i></button>
              <button class="btnDelete" data-id="<%=item.id%>"><i class="fa-solid fa-xmark"></i></button>
            </div>
        </div>
        <%})%>
    </div>
    <footer>
        <div>
            <h3>Thông tin doanh nghiệp</h3>
            <p>Công Ty TNHH Công Nghệ IMZ</p>
            <p>MST:......</p>
            <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
            <p>Email:......</p>
            <a href="/"><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"></a>
            <a href="/"><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"></a>
            <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss"></a> 
            <h3>Mạng xã hội</h3>
            <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb"></a>
            <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo"></a>
            <a href="/"><img src="/img/logo_tiktok.avif" alt="logo_youtube"></a>
            <a href="/"><img src="/img/logo_youtube.webp" alt="logo_youtube"></a>   
        </div>
        <div>
            <h3>Chính sách</h3>
            <a href="/">AI Privacy & Trust</a><br>
            <a href="/">Điều khoản dịch vụ</a><br>
            <a href="/">Tuyên bố từ chối trách nhiệm</a><br>
            <h3>Cổng thanh toán</h3>
            <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal"></a>
            <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo"></a>
            <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay"></a>
            <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank"></a>
        </div>
        <div>
            <h3>Công cụ</h3>
            <a href="/">To Do List</a><br>
            <a href="/">Ứng dụng 2</a><br>
            <a href="/">Ứng dụng 3</a><br>
        </div>
        <div>
            <h3>Đăng ký nhận tin khuyến mãi</h3>
            <p>Email</p>
            <input type="text"><br>
            <p>Số điện thoại</p>
            <input type="text"><br>
            <button>Đăng ký</button>
        </div>
    </footer>
    </div>
    
</body>
<script type="module" src="/todo.js" defer></script>
</html>