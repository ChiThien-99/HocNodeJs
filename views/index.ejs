<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang chủ</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm">
            <i class="fa-solid fa-check"></i> Xác nhận
          </button>
          <button id="btnDeny">
            <i class="fa-solid fa-xmark"></i> Từ chối
          </button>
        </div>
      </div>
      <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" loading="lazy"/>
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <div id="navMenu">
        <nav>
          <ul>
            <li><a href="#">Trang chủ</a></li>
            <li>
              <a href="#" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="#">Thiết bị</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Problem?</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button>Đăng ký</button>
          <button>Đăng nhập</button>
        </div>
      </div>
    </header>
      <main>
        <div id="divAboutAndBanner">
          <div id="notification-container">
            <div id="headerNotification">
               <h3><i class="fa-solid fa-bell"></i> Thông báo</h3>
               <select name="filterNotification" id="filterNotification">
                 <option value="all">Tất cả</option>
                 <option value="system">Hệ thống</option>
                 <option value="event">Sự kiện</option>
                 <option value="app">Phần mềm</option>
                 <option value="device">Thiết bị</option>
                 <option value="blogs">Blog</option>
               </select>
            </div>
            <div id="bodyNotification">
              <%notifys.forEach((notify)=>{%>
              <div class="notify">
                <a href="<%=notify.url%>" target="_blank">
               <div class="headerNotify">
                <span><%=notify.type%></span>
                <span><%=new Date(notify.createAt).toLocaleString()%></span>
              </div>
              <p><%=notify.content%></p>
                </a>
            </div>
            <%})%>
            </div>
          </div>
          <div id="carousel-container">
            <div id="carousel-wrapper">
              <%banners.forEach((banner)=>{%>
              <div class="carousel-slide">
                <a href="<%=banner.url%>" target="_blank">
                   <img src="<%=banner.image%>" loading="lazy" alt="banner1">
                   <div class="carousel-caption"><%=banner.caption%></div>
                </a>
              </div>
              <%})%>
            </div>
            <button id="prev" data-index="-1"><i class="fa-solid fa-angle-left"></i></button>
            <button id="next" data-index="1"><i class="fa-solid fa-angle-right"></i></button>
            <div id="indicators">
              <%banners.forEach((_,i)=>{%>
              <span class="dot <%=(i===0)?'active':''%>" data-index="<%=i%>"></span>
              <%})%>
            </div>
          </div>
        </div>
        <div id="divApp">
          <div id="headerApp">
            <h2 class="flag-item">Phần mềm</h2>
            <a href="/app" target="_blank">Xem tất cả</a>
          </div>
          <div id="groupFilterApp">
            <button id="btnNewApp" class="active">Mới nhất</button>
            <button id="btnPopularApp">Phổ biến</button>
            <button id="btnFuncApp">Chức năng <i class="fa-solid fa-caret-right"></i></button>
            <div id="divFuncBtns">
            <div id="funcBtns">
              <div id="divDeleteFuncBtn"><a id="deleteFuncBtn"><i class="fa-solid fa-filter-circle-xmark"></i>Xóa lọc</a></div>
              <%funcApps.forEach((funcApp)=>{%>
              <button class="funcBtn"><%=funcApp.name%></button>
              <%})%>
            </div>
            </div>
          </div>
          <div id="listApp">
            <%apps.forEach((app)=>{%>
            <div class="app">
              <div>
                <img src="<%=app.image%>" alt="app">
              </div>
              <div>
                <h4><%=app.name%></h4>
                <p><%=app.info%></p>
                <a href="/app/<%=app.name%>/<%=app._id%>" target="_blank">Truy cập</a>
              </div>
            </div>
            <%})%>
          </div>
        </div>
        <div id="divDevice">
          <div id="headerDevice">
            <h2 class="flag-item">Thiết bị</h2>
            <a href="/alldevice" target="_blank">Xem tất cả</a>
          </div>
          <div id="groupFilterDevice">
            <button id="btnNewDevice" class="active">Mới nhất</button>
            <button id="btnPopularDevice">Phổ biến</button>
            <button id="btnPriceLowHigh">Giá Thấp->Cao</button>
            <button id="btnPriceHighLow">Giá Cao->Thấp</button>
            <button id="btnFuncDevice">Chức năng <i class="fa-solid fa-caret-right"></i></button>
            <div id="divFuncDeviceBtns">
            <div id="funcDeviceBtns">
              <div id="divDeleteFuncDeviceBtn"><a id="deleteFuncDeviceBtn"><i class="fa-solid fa-filter-circle-xmark"></i>Xóa lọc</a></div>
              <%funcDevices.forEach((funcDevice)=>{%>
              <button class="funcDeviceBtn"><%=funcDevice.name%></button>
              <%})%>
            </div>
            </div>
          </div>
          <div id="listDevice">
            <%devices.forEach((device)=>{%>
            <div class="device">
              <div>
                <img src="<%=device.image%>" alt="device">
                <p><%=device.price.toLocaleString('vi-VN')%>đ</p>
              </div>
              <div>
                <h4><%=device.name%></h4>
                <p><%=device.info%></p>
                <a href="/device/<%=device.name%>/<%=device._id%>" target="_blank">Xem chi tiết</a>
              </div>
            </div>
            <%})%>
          </div>
        </div>
        <div id="divblogs">
          <div id="headerblogs">
            <h2 class="flag-item">Blog</h2>
            <a href="/blogs" target="_blank">Xem tất cả</a>
          </div>
           <div id="groupFilterCategoryblogs">
              <%listCategoryblogs.forEach((categoryblogs)=>{%>
              <button class="categoryblogs"><%=categoryblogs.name%></button>
              <%})%>
            </div>
          <div id="listblogs">
            <%listblogs.forEach((blogs)=>{%>
            <div class="blogs">
              <a href="/blogs/detailBlog/<%=blogs._id%>" target="_blank" class="linkImg"><img src="<%=blogs.image%>" alt="blogs"></a>
              <div class="blogs-content">
                <a href="/blogs/detailBlog/<%=blogs._id%>" target="_blank"><h4><%=blogs.title%></h4></a>
                <p>
                  <%
                  let plainText=blogs.info.replace(/<\/?[^>]+(>|$)/g,"");
                  plainText=plainText.replace(/&nbsp;|&#160;/gi," ");
                  plainText=plainText.replace(/&quot;/gi,'"');
                  plainText=plainText.replace(/&#39;/gi,"'");
                  plainText=plainText.replace(/\s+/g," ").trim();
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%=shortText%>
                </p> 
              </div>
            </div>
            <%})%>
          </div>
        </div>
        <div></div>
      </main>
      <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Công cụ</h3>
          <a href="/">To Do List</a><br />
          <a href="/">Ứng dụng 2</a><br />
          <a href="/">Ứng dụng 3</a><br />
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
    <script src="/socket.io/socket.io.js"></script>
  </body>
  <script type="module" src="/index.js" defer></script>
</html>