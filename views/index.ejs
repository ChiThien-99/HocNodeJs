<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang chủ</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/vanilla-emoji-picker@0.2.4/dist/emojiPicker.min.js"></script>
  </head>
  <body>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm">
            <i class="fa-solid fa-check"></i> Xác nhận
          </button>
          <button id="btnDeny">
            <i class="fa-solid fa-xmark"></i> Từ chối
          </button>
        </div>
      </div>
      <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" loading="lazy"/>
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <div id="navMenu">
        <nav>
          <ul>
            <li><a href="/" target="_blank">Trang chủ</a></li>
            <li>
              <a href="/app" id="navCongCu" target="_blank">Phần mềm</a>
            </li>
            <li><a href="/device" target="_blank">Thiết bị</a></li>
            <li><a href="/blogs" target="_blank">Blog</a></li>
            <li><a href="#" target="_blank">Problem?</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button>Đăng ký</button>
          <button>Đăng nhập</button>
        </div>
      </div>
    </header>
      <main>
        <div id="divAboutAndBanner">
          <div id="notification-container">
            <div id="headerNotification">
               <h3><i class="fa-solid fa-bell"></i> Thông báo</h3>
               <select name="filterNotification" id="filterNotification">
                 <option value="all">Tất cả</option>
                 <option value="system">Hệ thống</option>
                 <option value="event">Sự kiện</option>
                 <option value="app">Phần mềm</option>
                 <option value="device">Thiết bị</option>
                 <option value="blogs">Blog</option>
               </select>
            </div>
            <div id="bodyNotification">
              <%notifys.forEach((notify)=>{%>
              <div class="notify" data-idNotify="<%=notify._id%>">
                <a href="<%=notify.url%>" target="_blank">
               <div class="headerNotify">
                <span class="headerNotifyType"><%=notify.type%></span>
                <span class="headerNotifyCreateAt"><%=new Date(notify.createAt).toLocaleString("vi-VN")%></span>
              </div>
              <p><%=notify.content%></p>
                </a>
            </div>
            <%})%>
            </div>
          </div>
          <div id="carousel-container">
            <div id="carousel-wrapper">
              <%carousels.forEach((carousel)=>{%>
              <div class="carousel-slide" data-idCarousel="<%=carousel._id%>">
                <a href="<%=carousel.url%>" target="_blank">
                   <img src="<%=carousel.image%>" loading="lazy" alt="carousel">
                   <div class="carousel-caption"><%=carousel.caption%></div>
                </a>
              </div>
              <%})%>
            </div>
            <button id="prev" data-index="-1"><i class="fa-solid fa-angle-left"></i></button>
            <button id="next" data-index="1"><i class="fa-solid fa-angle-right"></i></button>
            <div id="indicators">
              <%carousels.forEach((_,i)=>{%>
              <span class="dot <%=(i===0)?'active':''%>" data-index="<%=i%>"></span>
              <%})%>
            </div>
          </div>
        </div>
        <div id="divApp">
          <div id="headerApp">
            <a class="flag-item" href="/app">Phần mềm</a>
            <a href="/app" target="_blank">Xem tất cả <i class="fa-solid fa-angles-right"></i></a>
          </div>
          <div id="listApp">
            <%apps.forEach((app)=>{%>
            <a href="/detailApp/<%=app._id%>" target="_blank">
              <div class="app">
              <div>
                <img src="<%=app.image%>" alt="app">
              </div>
              <div>
                <h4><%=app.name%></h4>
                <p><%-app.info.replace(/&nbsp;|&#160;/gi," ")%></p>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
        <div id="divDeviceIndex">
          <div id="headerDeviceIndex">
            <a class="flag-item" href="/device">Thiết bị</a>
            <a href="/device" target="_blank">Xem tất cả <i class="fa-solid fa-angles-right"></i></a>
          </div>
          <div id="listDeviceIndex">
            <%devices.forEach((device)=>{%>
            <a href="/detailDevice/<%=device._id%>" target="_blank">
              <div class="deviceIndex">
              <div>
                <img src="<%=device.images[0].url%>" alt="device">
                <p><%=device.price.toLocaleString('vi-VN')%>đ</p>
              </div>
              <div class="device-content">
                <h4><%=device.name%></h4>
                <div class="rawDeviceInfo">
                  <%-device.info.replace(/&nbsp;|&#160;/gi," ")%>
                </div>
                <div class="targetDeviceInfo"></div>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
        <div id="divblogs">
          <div id="headerblogs">
            <a class="flag-item" href="/blogs">Blog</a>
            <a href="/blogs" target="_blank">Xem tất cả <i class="fa-solid fa-angles-right"></i></a>
          </div>
          <div id="listblogs">
            <%listblogs.forEach((blogs)=>{%>
            <a href="/blogs/detailBlog/<%=blogs._id%>" target="_blank">
              <div class="blogs">
              <img src="<%=blogs.image%>" alt="blogs">
              <div class="blogs-content">
                <h4><%=blogs.title%></h4>
                <p>
                  <%
                  let plainText=blogs.info.replace(/&nbsp;|&#160;/gi," ");
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%-shortText%>
                </p> 
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
        <a class="flag-item" href="/app">Các phiên bản khác</a>
        <div id="operaSystem">
          <div id="filterOpera">
            <button data-opera="android" class="active"><i class="fa-brands fa-android"></i> ANDROID</button>
            <button data-opera="ios"><i class="fa-brands fa-apple"></i> IOS</button>
            <button data-opera="windows"><i class="fa-brands fa-windows"></i> WINDOWS</button>
          </div>
          <div id="contentOpera">
            <div id="android" class="active">
              <img src="/img/QR_Code.webp" alt="QR Android">
              <h3>Quét mã QR để tải ứng dụng từ CH Play</h3>
            </div>
            <div id="ios">
              <img src="/img/QR_Code.webp" alt="QR IOS">
              <h3>Quét mã QR để tải ứng dụng từ App Store</h3>
            </div>
            <div id="windows">
              <button><i class="fa-solid fa-download"></i> Tải về</button>
              <h3>Click nút để tải phần mềm về máy của bạn</h3>
            </div>
          </div>
        </div>
        <a class="flag-item" href="/app">Your Problem?</a>
        <div id="problem">
          <form id="formProblem">
            <label for="name">Tên của bạn (Để trống nếu muốn ẩn danh)</label><br>
            <input type="text" name="name" id="name"><br>
            <label for="contentProblem">Vấn đề của bạn</label><br>
            <textarea name="contentProblem" id="contentProblem" placeholder="Vấn đề của bạn sẽ được lắng nghe và trở thành cơ sở để chúng tôi phát triển sản phẩm công nghệ giải quyết các vấn đề của bạn trong tương lai" data-emoji-picker="true"></textarea><br>
            <input type="submit" value="Gửi">
          </form>
        </div>
      </main>
      <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Công cụ</h3>
          <a href="/">To Do List</a><br />
          <a href="/">Ứng dụng 2</a><br />
          <a href="/">Ứng dụng 3</a><br />
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
    <script src="/socket.io/socket.io.js"></script>
  </body>
  <script type="module" src="/index.js" defer></script>
</html>