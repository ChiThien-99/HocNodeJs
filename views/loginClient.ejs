<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Client</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="icon"
      href="/img/logo_imzen01-final - 32x32.png"
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href="/img/logo_imzen01-final - 16x16.png"
      type="image/png"
      sizes="16x16"
    />
    <link
      rel="apple-touch-icon"
      href="/img/logo_imzen01-final.png"
      sizes="180x180"
    />
    <link
      rel="shortcut icon"
      href="/img/logo_imzai_1.ico"
      type="image/x-icon"
    />
    <link
      rel="preload"
      href="/Geomini-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <div id="alert">
      <h4 id="headingAlert">Tiêu đề thông báo</h4>
      <p id="contentAlert">Thông báo lần 1</p>
    </div>
    <div id="myModal">
      <div id="modalContent">
        <p>Điền mã OTP được gửi về mail của bạn để kích hoạt tài khoản</p>
        <form id="formOtp">
          <label for="otpCode"
            >Mã OTP sẽ hết hạn sau <span id="countdownTimer">05:00</span></label
          >
          <button type="button" id="btnResendOtp">Gửi lại mã OTP</button><br />
          <input type="number" name="otpCode" id="otpCode" required />
          <input type="submit" value="Kích hoạt" />
        </form>
      </div>
    </div>
    <div id="logoLogin">
      <h1>
        <a href="/" class="logo-link">
          <img src="/img/logo_imzen01-final.webp" alt="logo" />
          <span>VÂN HY</span>
        </a>
      </h1>
    </div>
    <div id="loginClientContainer">
      <div id="headerLogin">
        <button
          id="btnRegisterClient"
          data-idLogin="registerClient"
          class="<%=headerActive==='registerClient'?'active':''%>"
        >
          Đăng ký
        </button>
        <button
          id="btnLoginClient"
          data-idLogin="loginClient"
          class="<%=headerActive==='loginClient'?'active':''%>"
        >
          Đăng nhập
        </button>
      </div>
      <div id="bodyLogin">
        <div
          id="registerClient"
          class="<%=headerActive==='registerClient'?'active':''%>"
        >
          <p><sup>*</sup>Trường bắt buộc</p>
          <form id="formRegisterClient">
            <div>
              <label for="fullNameClient">Họ và tên<sup>*</sup></label
              ><br />
              <input
                type="text"
                name="fullNameClient"
                id="fullNameClient"
                required
              />
            </div>
            <div id="divBirthAndGender">
              <div id="divDateBirthClient">
                <label for="dateBirthClient"
                  >Ngày/tháng/năm sinh<sup>*</sup></label
                ><br />
                <input
                  type="text"
                  name="dateBirthClient"
                  id="dateBirthClient"
                  placeholder="dd/mm/yyyy"
                  maxlength="10"
                  required
                />
              </div>
              <div id="divGenderClient">
                <label for="genderClient">Giới tính<sup>*</sup></label
                ><br />
                <select name="genderClient" id="genderClient">
                  <option value="male">Nam</option>
                  <option value="female">Nữ</option>
                </select>
              </div>
            </div>
            <div>
              <label for="telClient">Số điện thoại</label><br />
              <input type="tel" name="telClient" id="telClient" />
            </div>
            <div>
              <label for="emailClient">Email<sup>*</sup></label
              ><br />
              <input
                type="email"
                name="emailClient"
                id="emailClient"
                required
              />
            </div>
            <div>
              <label for="pwClient">Mật khẩu<sup>*</sup></label
              ><br />
              <input type="password" name="pwClient" id="pwClient" required />
              <button id="togglePwClient">
                <i class="fa-solid fa-eye"></i>
              </button>
              <p>Mật khẩu có ít nhất 8 ký tự</p>
              <p>
                Mật khẩu phải chứa ít nhất 1 chữ cái, 1 chữ số, 1 ký tự đặc biệt
              </p>
            </div>
            <div>
              <label for="pwReClient">Nhập lại mật khẩu<sup>*</sup></label
              ><br />
              <input
                type="password"
                name="pwReClient"
                id="pwReClient"
                required
              />
              <button id="togglePwReClient">
                <i class="fa-solid fa-eye"></i>
              </button>
              <p id="checkPw"></p>
            </div>
            <div>
              <input type="submit" value="Đăng ký" id="btnSubmitRegister" />
              <button id="btnCancelRegister">Hủy</button>
            </div>
          </form>
        </div>
        <div
          id="loginClient"
          class="<%=headerActive==='loginClient'?'active':''%>"
        >
          <form id="loginForm">
            <div>
              <label for="emailClient2">Email</label><br />
              <input type="email" name="emailClient2" id="emailClient2" />
            </div>
            <div>
              <label for="pwClient2">Mật khẩu</label><br />
              <input type="password" name="pwClient2" id="pwClient2" />
              <button id="togglePwClient2">
                <i class="fa-solid fa-eye"></i></button
              ><br />
              <p id="btnForgotPass">Quên mật khẩu</p>
              <input type="checkbox" name="rememberMe" id="rememberMe" />
              <label for="rememberMe"
                >Lưu trạng thái đăng nhập
                <p class="tooltip">
                  <i class="fa-solid fa-circle-info"></i
                  ><span class="tooltiptext"
                    >Trạng thái đăng nhập sẽ được duy trì trong 30 ngày</span
                  >
                </p></label
              >
            </div>
            <div>
              <button type="submit" id="btnLoginCL">Đăng nhập</button><br />
            </div>
            <div>
              <em id="messLoginClient">
                Số lần đăng nhập còn lại
                <span id="remainingRate">--</span>/<span id="limitRate"
                  >--</span
                >
              </em>
              <div id="rateLimitAlert">
                <strong>Quá nhiều lần thử !</strong>
                <p id="remainingTime">Vui lòng chờ...</p>
              </div>
            </div>
          </form>
          <form id="formForgotPass">
            <div id="divFirstForgotPW">
              <p id="btnBackLoginFrom">
                <i class="fa-solid fa-arrow-left-long"></i> Quay lại
              </p>
              <label for="emailForgotPass">Email</label><br />
              <input type="email" name="emailForgotPass" id="emailForgotPass" />
            </div>
            <div id="divSecondForgotPW">
              <label for="otpForgotPass">Mã OTP</label><br />
              <input type="number" name="otpForgotPass" id="otpForgotPass" />
            </div>
            <div id="divThridForgotPW">
              <label for="newPass">Mật khẩu mới</label><br />
              <input type="password" name="newPass" id="newPass" />
              <button id="toggleNewPW">
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
            <div>
              <button type="button" id="btnHandleForgotPass">Tiếp tục</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cleave.js/1.6.0/cleave.min.js"></script>
  </body>
  <script type="module" src="/loginClient.js" defer></script>
</html>
