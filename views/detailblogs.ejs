<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%=blogs.title%>">
     <%
        let plainText=blogs.info.replace(/<\/?[^>]+(>|$)/g,"");
        plainText=plainText.replace(/&nbsp;|&#160;/gi," ");
        plainText=plainText.replace(/&quot;/gi,'"');
        plainText=plainText.replace(/&#39;/gi,"'");
        plainText=plainText.replace(/\s+/g," ").trim();
        let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
      %>            
    <meta property="og:description" content="<%=shortText%>">
    <meta property="og:image" content="<%=blogs.image%>">
    <meta property="og:url" content="https://confider-bronzing-manlike.ngrok-free.dev/blogs/detailblogs/6a0ac8e2063255e49ce95beb?fbclid=IwZXh0bgNhZW0CMTEAYnJpZBExazR0ZGhQQ05jNWVFTU1Ob3NydGMGYXBwX2lkATAAAR7VmzhanC94mvNzcsyWV22XbgVo2S_M0VuAJznlCW3IEJBs6AjrdCAIPEYg3w_aem_oHaxQqMtoc9Bt9GYQuxe9w">
    <title><%=blogs.title%></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/vanilla-emoji-picker@0.2.4/dist/emojiPicker.min.js"></script>
  </head>
  <body>
    <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" loading="lazy"/>
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <div id="navMenu">
        <nav>
          <ul>
            <li><a href="#">Trang chủ</a></li>
            <li>
              <a href="#" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="#">Thiết bị</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Problem?</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button>Đăng ký</button>
          <button>Đăng nhập</button>
        </div>
      </div>
    </header>
    <main id="mainDetailblogs">
      <article>
        <p><%=new Date(blogs.createAt).toLocaleString()%></p>
        <h1><%=blogs.title%></h1>
        <div id="divCategoryAndShare">
          <p>Danh mục: <%=blogs.category%></p>
          <div id="divShare">
            <div>
              <button id="btnShareFB"><img src="/img/logo_fb.webp" alt="facebook"></button>
              <button id="btnShareZL"><img src="/img/logo_zalo.webp" alt="zalo"></button>
            </div>
            <button id="btnShare"><i class="fa-solid fa-share-nodes"></i> Chia sẻ</button>
          </div>
          
        </div>
        <div id="divInfoblogs">
          <%let cleanContent = blogs.info.replace(/&nbsp;/g, ' ');%>
          <%-cleanContent%>
        </div>
        <div id="divComment">
          <h3 id="lenComment">Bình luận <%=comments.length%></h3>
          <form id="formComment">
            <input type="hidden" name="idblogs" id="idblogs" value="<%=blogs._id%>"><br>
            <input type="text" name="authorComment" id="authorComment" placeholder="Tên của bạn (Để trống nếu muốn ẩn danh)"><br>
            <div id="divContentEmojiComment">
              <input type="hidden" name="parentCommentId" id="parentCommentId">
              <textarea name="contentComment" id="contentComment" placeholder="Nội dung bình luận" data-emoji-picker="true"></textarea><br>
            </div>
            <input type="submit" value="Bình luận">
          </form>
          <div id="listComment">
            <%if(comments.length===0){%>
              <p id="noComment">Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</p>
            <%}else{%>
            <%comments.forEach((comment)=>{%>
            <%if(!comment.parentId){%>
            <div class="comment">
            <p>
              <strong><%=comment.author%></strong>
              <span><%=comment.content%></span>
            </p>
            <div class="comment-action">
              <div>
                <button type="button" class="btnLikeComment" data-idComment="<%=comment._id%>"><i class="fa-solid fa-thumbs-up"></i> Thích (<span id="like-count-<%=comment._id%>"><%=comment.likes.length%></span>)</button>
                <button type="button" class="btnReplyComment" data-idComment="<%=comment._id%>" data-authorComment="<%=comment.author%>"><i class="fa-solid fa-comment"></i> Trả lời</button>
              </div>
               <p><%=new Date(comment.createAt).toLocaleString("vi-VN")%></p>
            </div>
            </div>
            <div class="replies-box">
              <%comments.forEach((reply)=>{%>
                <%if(String(reply.parentId)===String(comment._id)){%>
                  <div class="comment">
            <p>
              <strong><%=reply.author%></strong>
              <span><%=reply.content%></span>
            </p>
            <div class="comment-action">
              <div>
                <button type="button" class="btnLikeComment" data-idComment="<%=reply._id%>"><i class="fa-solid fa-thumbs-up"></i> Thích (<span id="like-count-<%=reply._id%>"><%=reply.likes.length%></span>)</button>
                <button type="button" class="btnReplyComment" data-idComment="<%=comment._id%>" data-authorComment="<%=reply.author%>"><i class="fa-solid fa-comment"></i> Trả lời</button>
              </div>
               <p><%=new Date(reply.createAt).toLocaleString("vi-VN")%></p>
            </div>
            </div>
                <%}%>
              <%})%>
            </div>
            <%}%>
            <%})}%>
          </div>
        </div>
        <div>
          <a class="flag-item" href="/blogs">Blog liên quan</a>
            <div id="listblogs">
            <%relatedblogs.forEach((blogs)=>{%>
            <a href="/blogs/detailBlog/<%=blogs._id%>" class="linkImg">
              <div class="blogs">
              <img src="<%=blogs.image%>" alt="blogs">
              <div class="blogs-content">
                <h4><%=blogs.title%></h4>
                  <%
                  let plainText=blogs.info.replace(/&nbsp;|&#160;/gi," ");
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%-shortText%>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
        <div>
             <a class="flag-item" href="/blogs">Blog mới nhất</a>
            <div id="listblogs">
            <%latestblogs.forEach((blogs)=>{%>
            <a href="/blogs/detailBlog/<%=blogs._id%>" class="linkImg">
              <div class="blogs">
              <img src="<%=blogs.image%>" alt="blogs">
              <div class="blogs-content">
                <h4><%=blogs.title%></h4>
                  <%
                  let plainText=blogs.info.replace(/&nbsp;|&#160;/gi," ");
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%-shortText%>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
      </article>
      <aside>
        <%if(banners.length>0){%>
        <div id="banner">
            <a href="<%=banners[0].url%>" target="_blank"><img src="<%=banners[0].image%>" alt="banner"></a>
        </div>
        <%}%>
        <div>
          <a class="flag-item" href="/app" target="_blank">Phần mềm</a>
          <div id="listAppCol">
            <%apps.forEach((app)=>{%>
            <a href="/detailApp/<%=app._id%>" target="_blank">
              <div class="appCol">
              <div>
                <img src="<%=app.image%>" alt="app">
              </div>
              <div>
                <h4><%=app.name%></h4>
                <%-app.info.replace(/&nbsp;|&#160;/gi," ")%>
              </div>
            </div>
            </a>         
            <%})%>
          </div>
        </div>
        <div>
          <a class="flag-item" href="/device" target="_blank">Thiết bị</a>
          <div id="listDeviceCol">
            <%devices.forEach((device)=>{%>
            <a href="/detailDevice/<%=device._id%>" target="_blank">
               <div class="deviceCol">
              <div>
                <img src="<%=device.images[0].url%>" alt="device">
                <p><%=device.price.toLocaleString('vi-VN')%>đ</p>
              </div>
              <div class="deviceContent">
                <h4><%=device.name%></h4>
                <div class="rawDeviceInfo">
                  <%-device.info.replace(/&nbsp;|&#160;/gi," ")%>
                </div>
                <div class="targetDeviceInfo"></div>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
      </aside>
    </main>
    <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Sản phẩm</h3>
          <a href="/">Phần mềm</a><br />
          <a href="/">Thiết bị</a><br />
          <h3><a href="/">Blog</a></h3>
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
      <script src="/socket.io/socket.io.js"></script>
  </body>
  <script type="module" src="/detailblogs.js" defer></script>
</html>
