<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=device.name%></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
</head>
<body>
    <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" />
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <div id="navMenu">
        <nav>
          <ul>
            <li><a href="#">Trang chủ</a></li>
            <li>
              <a href="#" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="#">Thiết bị</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Problem?</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button>Đăng ký</button>
          <button>Đăng nhập</button>
        </div>
      </div>
    </header>
    <main id="mainDetailDevice">
        <div id="rawQuillContent">
          <%-device.info.replace(/&nbsp;|&#160;/gi," ")%>
        </div>
        <div id="detailDevice">
            <div id="headerDetailDevice">
            <div id="carousel-container">
            <div id="carousel-wrapper">
              <%device.images.forEach((img)=>{%>
              <div class="carousel-slide">
                <img src="<%=img.url%>" loading="lazy" alt="img_device">
              </div>
              <%})%>
            </div>
            <button id="prev" data-index="-1"><i class="fa-solid fa-angle-left"></i></button>
            <button id="next" data-index="1"><i class="fa-solid fa-angle-right"></i></button>
            <div id="indicators">
              <%device.images.forEach((img,i)=>{%>
              <img src="<%=img.url%>" loading="lazy" alt="dot_img_device" class="dot <%=(i===0)?'active':''%>" data-index="<%=i%>"></img>
              <%})%>
            </div>
            <button id="prevDot"><i class="fa-solid fa-angle-left"></i></button>
            <button id="nextDot"><i class="fa-solid fa-angle-right"></i></button>
          </div>
            <div id="overViewDevice">
              <div>
                <h1><%=device.name%></h1>
                <div id="targetChucNang"></div>
              </div>
              <div>
                <b>Số lượng:</b>
                <input type="number" name="quantityDevice" id="quantityDevice" value="1" min="0"><br>
              </div>
              <div>
              <b>Màu sắc:</b>
              <div id="listColorDevice">
                <%device.color.forEach((color)=>{%>
                <div class="colorDevice" data-index="<%=color.index%>">
                  <img src="<%=color.url%>" loading="lazy" alt="colorDevice">
                  <p><%=color.name%></p>
                </div>
              <%})%>
              </div>
              </div>
              <div id="groupBtnDevice">
                <button id="btnCartDevice"><i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng</button>
                <button id="btnShareDevice"><i class="fa-solid fa-share-nodes"></i> Chia sẻ</button>
              </div>
            </div>
            </div>
            <div id="divShareSocial">
               <div>
                <p>Chia sẻ qua mạng xã hội:</p>
                <button id="btnShareFB"><img src="/img/logo_fb.webp" alt="logo_fb"></button>
                <button id="btnShareZL"><img src="/img/logo_zalo.webp" alt="logo_zl"></button>
               </div>
            </div>
            <div id="bodyDetailDevice">
              <div id="groupNavigationBodyDevice">
              <button data-naviDevice="divInstructionDevice" class="active">Hướng dẫn sử dụng</button>
              <button data-naviDevice="divParamDevice">Thông số thiết bị</button>
              <button data-naviDevice="divInfoDevice">Thông tin thiết bị</button>
              </div>
              <div id="mainBodyDetailDevice">
              <div id="divInstructionDevice" class="active">
                <iframe width="560" height="315" src="https://www.youtube.com/embed/gX7s6kMY2cg?si=uhtzMiFXD6O1fxn9" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </div>
              <div id="divParamDevice">
                <div id="targetThongSo"></div>
              </div>
              <div id="divInfoDevice">
                <div id="targetThongTin"></div>
              </div>
              </div>
            </div>
        </div>
        <aside>
        <div>
          <h3 class="flag-item">Phần mềm</h3>
          <div id="listAppCol">
            <%apps.forEach((app)=>{%>
            <a href="/detailApp/<%=app._id%>" target="_blank">
              <div class="appCol">
              <div>
                <img src="<%=app.image%>" alt="app">
              </div>
              <div>
                <h4><%=app.name%></h4>
                <%-app.info.replace(/&nbsp;|&#160;/gi," ")%>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
        <div>
          <h3 class="flag-item">Blogs</h3>
          <div id="listBlogs">
            <%blogs.forEach((blog)=>{%>
            <a href="/blogs/detailBlog/<%=blog._id%>" target="_blank">
              <div class="blogCol">
              <div>
                <img src="<%=blog.image%>" alt="blog">
              </div>
              <div>
                <h4><%=blog.title%></h4>
                <p>
                   <%
                  let plainText=blog.info.replace(/<\/?[^>]+(>|$)/g,"");
                  plainText=plainText.replace(/&nbsp;|&#160;/gi," ");
                  plainText = plainText.replace(/&quot;/g, '"');
                  plainText = plainText.replace(/&#39;/g, "'");
                  plainText=plainText.replace(/\s+/g," ").trim();
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%=shortText%>
                </p>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
      </aside>
    </main>
    <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Sản phẩm</h3>
          <a href="/app">Phần mềm</a><br />
          <a href="/device">Thiết bị</a><br />
          <h3><a href="/blogs">Blog</a></h3>
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
<script src="/socket.io/socket.io.js"></script>
</body>
<script type="module" src="/detailDevice.js" defer></script>
</html>