<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=device.name%></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" href="/img/logo_imzai_1.ico" type="image/x-icon" />
    <link
      rel="preload"
      href="/Minecraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/OpenSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      src="https://kit.fontawesome.com/c1f12001f0.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/vanilla-emoji-picker@0.2.4/dist/emojiPicker.min.js"></script>
</head>
<body>
    <div id="alert">
        <h4 id="headingAlert">Tiêu đề thông báo</h4>
        <p id="contentAlert">Thông báo lần 1</p>
      </div>
      <div id="confirm">
        <h4 id="headingConfirm">Tiêu đề thông báo</h4>
        <p id="contentConfirm">Thông báo lần 1</p>
        <div>
          <button id="btnConfirm">
            <i class="fa-solid fa-check"></i> Xác nhận
          </button>
          <button id="btnDeny">
            <i class="fa-solid fa-xmark"></i> Từ chối
          </button>
        </div>
      </div>
    <header>
      <div>
        <a href="/" class="logo-link">
          <svg viewBox="0 0 200 200" width="200" height="200">
            <defs>
              <path id="circlePath" d="M -210,90 A 85,85 0 1,1 -40,90 A 85,85 0 1,1 -210,90" />
            </defs>
            <g class="brand-group">
              <image href="/img/logo_imzai_1.webp" x="-200" y="15" width="150" height="150" clip-path="circle()" />
            <text class="rotating-text">
              <textPath href="#circlePath" startOffset="30%" text-anchor="middle">
               IMZEN
              </textPath>
            </text>
            </g>
          </svg>
        </a>
      </div>
      <div>
        <button type="button" class="hamburger-btn" id="hamburgerBtn">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
       </button>
       <span id="countCartHamburgerBtn">0</span>
      </div>
      
      <div id="navMenu">
        <nav>
          <ul>
            <li><a href="/">Trang chủ</a></li>
            <li>
              <a href="/app?sort=createAt" id="navCongCu">Phần mềm</a>
            </li>
            <li><a href="/device">Thiết bị</a></li>
            <li><a href="/blogs">Blog</a></li>
            <li><a href="#">Problem?</a></li>
          </ul>
        </nav>
        <div id="groupBtn">
          <button type="button" id="btnRegisterClient">Đăng ký</button>
          <button type="button" id="btnLoginClient">Đăng nhập</button>
        </div>
        <div id="containerUserLogin">
          <div id="infoUserLogin">
          <h3>Tên user</h3>
          <div id="groupBtnUserLogin">
            <button id="btnDashboardUserLogin">Dashboard</button>
            <button id="btnLogoutUserLogin">Đăng xuất</button>
          </div>
        </div>
        <div id="bagShopping">
          <i class="fa-brands fa-opencart"></i>
          <span>0</span>
        </div>
        </div>
      </div>
    </header>
    <main id="mainDetailDevice" data-idDetailDevice="<%=device._id%>">
        <div id="rawQuillContent">
          <%-device.info.replace(/&nbsp;|&#160;/gi," ")%>
        </div>
        <div id="detailDevice">
            <div id="headerDetailDevice">
            <div id="carousel-container">
            <div id="carousel-wrapper">
              <%device.images.forEach((img)=>{%>
              <div class="carousel-slide">
                <img src="<%=img.url%>" loading="lazy" alt="img_device">
              </div>
              <%})%>
            </div>
            <button id="prev" data-index="-1"><i class="fa-solid fa-angle-left"></i></button>
            <button id="next" data-index="1"><i class="fa-solid fa-angle-right"></i></button>
            <div id="indicators">
              <%device.images.forEach((img,i)=>{%>
              <img src="<%=img.url%>" loading="lazy" alt="dot_img_device" class="dot <%=(i===0)?'active':''%>" data-index="<%=i%>"></img>
              <%})%>
            </div>
          </div>
            <div id="overViewDevice">
              <div>
                <h1><%=device.name%></h1>
                <div id="targetChucNang"></div>
              </div>
              <div>
                <b>Số lượng:</b>
                <input type="number" name="quantityDevice" id="quantityDevice" value="1" min="0"><br>
              </div>
              <div>
              <b>Màu sắc:</b>
              <input type="hidden" name="inpColorDevice" id="inpColorDevice">
              <div id="listColorDevice">
                <%device.color.forEach((color)=>{%>
                <div class="colorDevice" data-index="<%=color.index%>">
                  <img src="<%=color.url%>" loading="lazy" alt="colorDevice">
                  <p><%=color.name%></p>
                </div>
              <%})%>
              </div>
              </div>
              <div>
                <b>Tổng tiền (<span id="quantityDevice2">1</span> x <%=device.priceLE.toLocaleString('vi-VN')%> đ)</b>
                <strong id="priceDevice" data-base-price="<%=device.priceLE%>"><%=device.priceLE.toLocaleString('vi-VN')%> đ</strong>
              </div>
              <div id="groupBtnDevice">
                <button id="btnCartDevice" data-idDevice="<%=device._id%>" data-nameDevice="<%=device.name%>" data-priceDevice="<%=device.priceLE%>"><i class="fa-solid fa-cart-plus"></i> Mua ngay</button>
                <button id="btnShareDevice"><i class="fa-solid fa-share-nodes"></i> Chia sẻ</button>
              </div>
            </div>
            </div>
            <div id="divShareSocial">
               <div>
                <p>Chia sẻ qua mạng xã hội:</p>
                <button id="btnShareFB"><img src="/img/logo_fb.webp" alt="logo_fb"></button>
                <button id="btnShareZL"><img src="/img/logo_zalo.webp" alt="logo_zl"></button>
               </div>
            </div>
            <div id="bodyDetailDevice">
              <div id="groupNavigationBodyDevice">
              <button data-naviDevice="divInstructionDevice" class="active">Hướng dẫn sử dụng</button>
              <button data-naviDevice="divParamDevice">Thông số thiết bị</button>
              <button data-naviDevice="divInfoDevice">Thông tin thiết bị</button>
              </div>
              <div id="mainBodyDetailDevice">
              <div id="divInstructionDevice" class="active">
                <%-device.instruction%>
              </div>
              <div id="divParamDevice">
                <div id="targetThongSo"></div>
              </div>
              <div id="divInfoDevice">
                <div id="targetThongTin"></div>
              </div>
              </div>
            </div>
            <div id="divCommentDevice">
          <h3 id="lenCommentDevice">Bình luận <%=commentDevice.length%></h3>
          <form id="formCommentDevice">
            <input type="hidden" name="idDevice" id="idDevice" value="<%=device._id%>"><br>
            <input type="text" name="authorCommentDevice" id="authorCommentDevice" placeholder="Tên của bạn (Để trống nếu muốn ẩn danh)"><br>
            <div id="divContentEmojiCommentDevice">
              <input type="hidden" name="parentCommentDeviceId" id="parentCommentDeviceId">
              <textarea name="contentCommentDevice" id="contentCommentDevice" placeholder="Nội dung bình luận" data-emoji-picker="true"></textarea><br>
            </div>
            <input type="submit" value="Bình luận">
          </form>
          <div id="listCommentDevice">
            <%if(commentDevice.length===0){%>
              <p id="noCommentDevice">Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</p>
            <%}else{%>
            <%commentDevice.forEach((comment)=>{%>
            <%if(!comment.parentId){%>
            <div class="commentDevice">
            <p>
              <strong><%=comment.author%></strong>
              <span><%=comment.content%></span>
            </p>
            <div class="commentDevice-action">
              <div>
                <button type="button" class="btnLikeCommentDevice" data-idComment="<%=comment._id%>"><i class="fa-solid fa-thumbs-up"></i> Thích (<span id="like-count-<%=comment._id%>"><%=comment.likes.length%></span>)</button>
                <button type="button" class="btnReplyCommentDevice" data-idComment="<%=comment._id%>" data-authorComment="<%=comment.author%>"><i class="fa-solid fa-comment"></i> Trả lời</button>
              </div>
               <p><%=new Date(comment.createAt).toLocaleString("vi-VN")%></p>
            </div>
            </div>
            <div class="repliesDevice-box">
              <%commentDevice.forEach((reply)=>{%>
                <%if(String(reply.parentId)===String(comment._id)){%>
            <div class="commentDevice">
            <p>
              <strong><%=reply.author%></strong>
              <span><%=reply.content%></span>
            </p>
            <div class="commentDevice-action">
              <div>
                <button type="button" class="btnLikeCommentDevice" data-idComment="<%=reply._id%>"><i class="fa-solid fa-thumbs-up"></i> Thích (<span id="like-count-<%=reply._id%>"><%=reply.likes.length%></span>)</button>
                <button type="button" class="btnReplyCommentDevice" data-idComment="<%=comment._id%>" data-authorComment="<%=reply.author%>"><i class="fa-solid fa-comment"></i> Trả lời</button>
              </div>
               <p><%=new Date(reply.createAt).toLocaleString("vi-VN")%></p>
            </div>
            </div>
                <%}%>
              <%})%>
            </div>
            <%}%>
            <%})}%>
          </div>
        </div>
        <%if(otherDevice.length>0){%>
        <div id="divOtherDevice">
          <a class="flag-item" href="/device">Các thiết bị khác</a>
          <div id="listOtherDevice">
            <%otherDevice.forEach((device)=>{%>
            <a href="/detailDevice/<%=device._id%>" target="_blank">
              <div class="device">
              <div class="divImg">
                <img src="<%=device.images[0].url%>" alt="device">
                <p><%=device.price.toLocaleString('vi-VN')%> đ</p>
              </div>
              <div class="device-content">
                <h4><%=device.name%></h4>
                <div class="rawChucNangOtherDevice">
                  <%-device.info.replace(/&nbsp;|&#160;/gi," ")%>
                </div>
                <div class="targetChucNangOtherDevice"></div>
              </div>
            </div>
            </a>
          <%})%>
          </div>
        </div>
        <%}%>
        </div>
        <aside>
        <%if(banners.length>0){%>
        <div id="banner" data-idBN="<%=banners[0]._id%>">
            <a href="<%=banners[0].url%>" target="_blank"><img src="<%=banners[0].image%>" alt="banner"></a>
        </div>
        <%}%>
        <div>
          <a class="flag-item" href="/app">Phần mềm</a>
          <div id="listAppCol">
            <%apps.forEach((app)=>{%>
            <div class="app" data-idApp="<%=app._id%>">
                <div>
                  <img src="<%=app.image%>" alt="app">
                </div>
              <div class="app-content">
                <h4><%=app.name%></h4>
                <div>
                  <%-app.info.replace(/&nbsp;|&#160;/gi," ")%>
                </div>
              </div>
              <div class="priceApp">
                 <%if(app.priceLE==="Miễn phí"){%>
                  <p>Miễn phí</p>
                <%}else{%>
                  <p><%=Number(app.priceLE).toLocaleString('vi-VN')%>đ%></p>
                  <p class="statusTrial">Dùng thử 30 ngày</p>
                <%}%>
              </div>
            </div>
            <%})%>
          </div>
        </div>
        <div>
          <a class="flag-item" href="/blogs">Blogs</a>
          <div id="listBlogs">
            <%blogs.forEach((blog)=>{%>
            <a href="/blogs/detailBlog/<%=blog._id%>" target="_blank">
              <div class="blogCol">
              <div>
                <img src="<%=blog.image%>" alt="blog">
              </div>
              <div>
                <h4><%=blog.title%></h4>
                <p>
                   <%
                  let plainText=blog.info.replace(/&nbsp;|&#160;/gi," ");
                  let shortText=plainText.length>200?plainText.substring(0,200)+"...":plainText;
                  %>
                  <%-shortText%>
                </p>
              </div>
            </div>
            </a>
            <%})%>
          </div>
        </div>
      </aside>
    </main>
    <footer>
        <div>
          <h3>Thông tin doanh nghiệp</h3>
          <p>Công Ty TNHH Công Nghệ IMZEN</p>
          <p>MST:......</p>
          <p>Địa chỉ:...... <a href="/">Xem bản đồ</a></p>
          <p>Email:......</p>
          <a href="/"
            ><img src="/img/bocongthuong.webp" alt="logo_bocongthuong"
          /></a>
          <a href="/"
            ><img src="/img/chung_chi_ssl.webp" alt="logo_chung_chi_ssl"
          /></a>
          <a href="/"><img src="/img/pci_dss.png" alt="logo_pci_dss" /></a>
          <h3>Mạng xã hội</h3>
          <a href="/"><img src="/img/logo_fb.webp" alt="logo_fb" /></a>
          <a href="/"><img src="/img/logo_zalo.webp" alt="logo_zalo" /></a>
          <a href="/"><img src="/img/tiktok2_trans_1.webp" alt="logo_tiktok" /></a>
          <a href="/"
            ><img src="/img/logo_youtube.webp" alt="logo_youtube"
          /></a>
        </div>
        <div>
          <h3>Chính sách</h3>
          <a href="/">AI Privacy & Trust</a><br />
          <a href="/">Điều khoản dịch vụ</a><br />
          <a href="/">Tuyên bố từ chối trách nhiệm</a><br />
          <h3>Cổng thanh toán</h3>
          <a href="/"><img src="/img/logo_paypal.webp" alt="logo_paypal" /></a>
          <a href="/"><img src="/img/logo_momo.webp" alt="logo_momo" /></a>
          <a href="/"><img src="/img/logo_vnpay.webp" alt="logo_vnpay" /></a>
          <a href="/"><img src="/img/logo_bank.webp" alt="logo_bank" /></a>
        </div>
        <div>
          <h3>Sản phẩm</h3>
          <a href="/app">Phần mềm</a><br />
          <a href="/device">Thiết bị</a><br />
          <h3><a href="/blogs">Blog</a></h3>
        </div>
        <div>
          <h3>Đăng ký nhận tin khuyến mãi</h3>
          <p>Email</p>
          <input type="text" /><br />
          <p>Số điện thoại</p>
          <input type="text" /><br />
          <button>Đăng ký</button>
        </div>
      </footer>
<script src="/socket.io/socket.io.js"></script>
</body>
<script type="module" src="/detailDevice.js" defer></script>
</html>